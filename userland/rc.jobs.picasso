# Job list of the Redmi K30 5G (picasso): run by the launchd job com.hakios.demo (src/init.c, run_rc).
# Everything here is started in the background so that init reaches its root console
# ("root@hakios-picasso#", on the USB CDC serial port) as soon as the list has been read.
# Deliberately no button press: a "lock" would sleep the screen.
/redwood/bin/rwtouch wait 10 notify com.hakios.unlock &
/redwood/bin/rwtouch wait 12 swipe 0.5 0.985 0.5 0.3 250 &
/redwood/bin/rwtouch wait 20 notify com.hakios.unlock &
/redwood/bin/rwtouch wait 22 swipe 0.5 0.985 0.5 0.3 250 &
/redwood/bin/rwtouch wait 40 notify com.hakios.unlock &
/redwood/bin/rwtouch wait 43 swipe 0.5 0.985 0.5 0.3 250 &
/redwood/bin/rwtouch wait 75 notify com.hakios.unlock &
/redwood/bin/rwtouch wait 78 swipe 0.5 0.985 0.5 0.3 250 &
/redwood/bin/rwtouch wait 85 notify com.hakios.dismiss_boot_ui &
/redwood/bin/rwtouch wait 86 notify com.hakios.unlock &
/redwood/bin/rwtouch wait 88 swipe 0.5 0.985 0.5 0.3 250 &
/redwood/bin/rwtouch wait 95 notify com.hakios.dismiss_boot_ui &
/redwood/bin/rwtouch wait 96 notify com.hakios.unlock &
/redwood/bin/rwtouch wait 98 swipe 0.5 0.985 0.5 0.3 250 &
/redwood/bin/rwtouch wait 110 notify com.hakios.unlock &
/redwood/bin/rwtouch wait 112 swipe 0.5 0.985 0.5 0.3 250 &
/redwood/bin/rwtouch wait 130 notify com.hakios.unlock &
/redwood/bin/rwtouch wait 132 swipe 0.5 0.985 0.5 0.3 250 &
