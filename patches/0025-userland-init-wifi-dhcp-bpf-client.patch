+static void
+interactive_shell(void)
+{
+	char line[512];
+
+	printf("\n");
+	printf("======================================================================\n");
+	printf("   Darwin 22.5.0 Darwin Kernel (arm64) - HakiOS Picasso (SM7250)      \n");
+	printf("   Root Console (USB CDC-ACM Serial) - uid: 0 (root)                 \n");
+	printf("======================================================================\n");
