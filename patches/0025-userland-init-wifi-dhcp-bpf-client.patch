+static void
+picasso_build_dhcp_frame(uint8_t *frame, size_t *out_len, const uint8_t *client_mac, uint32_t xid, uint8_t msg_type, const uint8_t *req_ip, const uint8_t *server_id)
+{
+	memset(frame, 0, 512);
+
+	/* Ethernet Header */
+	memset(frame, 0xff, 6); /* Broadcast dst */
+	memcpy(frame + 6, client_mac, 6);
+	frame[12] = 0x08; frame[13] = 0x00; /* IPv4 */
+
+	/* DHCP Options */
+	uint8_t *dhcp = frame + 42;
+	dhcp[0] = 1; /* BOOTREQUEST */
+	dhcp[1] = 1; /* Ethernet */
+	dhcp[2] = 6; /* MAC len */
+	dhcp[3] = 0;
+	memcpy(dhcp + 4, &xid, 4);
+	dhcp[10] = 0x80; dhcp[11] = 0x00; /* Broadcast flag */
+	memcpy(dhcp + 28, client_mac, 6);
+
+	/* Magic Cookie */
+	dhcp[236] = 0x63; dhcp[237] = 0x82; dhcp[238] = 0x53; dhcp[239] = 0x63;
+
+	size_t opt = 240;
+	/* Option 53: Message type */
+	dhcp[opt++] = 53; dhcp[opt++] = 1; dhcp[opt++] = msg_type;
+
+	if (req_ip) {
+		dhcp[opt++] = 50; dhcp[opt++] = 4;
+		memcpy(dhcp + opt, req_ip, 4); opt += 4;
+	}
+	if (server_id) {
+		dhcp[opt++] = 54; dhcp[opt++] = 4;
+		memcpy(dhcp + opt, server_id, 4); opt += 4;
+	}
+
+	/* Option 55: Parameter Request List */
+	dhcp[opt++] = 55; dhcp[opt++] = 4;
+	dhcp[opt++] = 1; dhcp[opt++] = 3; dhcp[opt++] = 6; dhcp[opt++] = 15;
+	dhcp[opt++] = 255; /* End */
+
+	size_t dhcp_len = opt;
+	if (dhcp_len < 300) dhcp_len = 300;
+
+	/* UDP Header */
+	uint8_t *udp = frame + 34;
+	uint16_t udp_len = (uint16_t)(8 + dhcp_len);
+	udp[0] = 0x00; udp[1] = 68; /* Src port 68 */
+	udp[2] = 0x00; udp[3] = 67; /* Dst port 67 */
+	udp[4] = (uint8_t)(udp_len >> 8);
+	udp[5] = (uint8_t)(udp_len & 0xff);
+	udp[6] = 0; udp[7] = 0;
+
+	/* IPv4 Header */
+	uint8_t *ip = frame + 14;
+	uint16_t ip_len = (uint16_t)(20 + udp_len);
+	ip[0] = 0x45; ip[1] = 0x00;
+	ip[2] = (uint8_t)(ip_len >> 8); ip[3] = (uint8_t)(ip_len & 0xff);
+	ip[4] = 0x00; ip[5] = 0x01;
+	ip[6] = 0x00; ip[7] = 0x00;
+	ip[8] = 64; ip[9] = 17;
+	/* Src 0.0.0.0, Dst 255.255.255.255 */
+	memset(ip + 12, 0, 4);
+	memset(ip + 16, 0xff, 4);
+
+	/* Checksum */
+	const uint8_t *p = ip;
+	uint32_t sum = 0;
+	for (int i = 0; i < 20; i += 2) {
+		sum += (uint32_t)((p[i] << 8) | p[i + 1]);
+	}
+	while (sum >> 16) sum = (sum & 0xffff) + (sum >> 16);
+	uint16_t ck = (uint16_t)(~sum & 0xffff);
+	ip[10] = (uint8_t)(ck >> 8); ip[11] = (uint8_t)(ck & 0xff);
+
+	*out_len = 14 + ip_len;
+}
+
+static int
+picasso_wait_dhcp_reply(int bpf, uint32_t bpf_bufsize, uint8_t *rx_buf, uint32_t expected_xid, uint8_t expected_type,
+                        uint8_t *yi, uint8_t *server_id, uint8_t *off_mask, uint8_t *off_router, uint8_t *off_dns,
+                        char *domain_name)
+{
+	for (int retry = 0; retry < 50; retry++) {
+		ssize_t nr = read(bpf, rx_buf, bpf_bufsize);
+		if (nr <= 0) {
+			usleep(20000);
+			continue;
+		}
+
+		uint8_t *p = rx_buf;
+		while (p + 18 <= rx_buf + nr) {
+			uint16_t hdrlen = *(uint16_t *)(p + 16);
+			uint32_t caplen = *(uint32_t *)(p + 8);
+			if (hdrlen == 0 || hdrlen > 64) hdrlen = 18;
+			if (p + hdrlen + caplen > rx_buf + nr) break;
+
+			uint8_t *frame = p + hdrlen;
+			uint32_t step = ((hdrlen + caplen + 3) & ~3);
+			p += step;
+
+			if (caplen < 42 + 240) continue;
+			if (frame[12] != 0x08 || frame[13] != 0x00) continue; /* IPv4 */
+			if (frame[23] != 17) continue; /* UDP */
+			if (frame[36] != 0x00 || frame[37] != 68) continue; /* Dst port 68 */
+
+			uint8_t *dhcp = frame + 42;
+			if (dhcp[0] != 2 /* BOOTREPLY */) continue;
+
+			uint32_t rx_xid;
+			memcpy(&rx_xid, dhcp + 4, 4);
+			if (rx_xid != expected_xid) continue;
+
+			/* Extract yiaddr */
+			memcpy(yi, dhcp + 16, 4);
+
+			uint8_t msg_type = 0;
+			if (dhcp[236] == 0x63 && dhcp[237] == 0x82 && dhcp[238] == 0x53 && dhcp[239] == 0x63) {
+				size_t o = 240;
+				size_t max_opt = caplen - 42;
+				while (o < max_opt && dhcp[o] != 255) {
+					if (dhcp[o] == 0) { o++; continue; }
+					uint8_t tag = dhcp[o++];
+					if (o >= max_opt) break;
+					uint8_t len = dhcp[o++];
+					if (o + len > max_opt) break;
+
+					if (tag == 53 && len >= 1) msg_type = dhcp[o];
+					else if (tag == 1 && len >= 4) memcpy(off_mask, dhcp + o, 4);
+					else if (tag == 3 && len >= 4) memcpy(off_router, dhcp + o, 4);
+					else if (tag == 6 && len >= 4) memcpy(off_dns, dhcp + o, 4);
+					else if (tag == 54 && len >= 4) memcpy(server_id, dhcp + o, 4);
+					else if (tag == 15 && len > 0) {
+						size_t dlen = len < 63 ? len : 63;
+						memcpy(domain_name, dhcp + o, dlen);
+						domain_name[dlen] = 0;
+					}
+					o += len;
+				}
+			}
+
+			if (expected_type != 0 && msg_type != expected_type) continue;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static void
+cmd_dhcp(const char *ifname)
+{
+	if (!ifname || !*ifname) ifname = "en0";
+
+	/* 1. Ensure interface is UP */
+	int s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 0);
+	if (s >= 0) {
+		struct {
+			char name[16];
+			union {
+				struct { uint8_t a, b; uint16_t c; uint32_t d; char z[8]; } sin;
+				short flags;
+				char pad[16];
+			} u;
+		} ifr;
+		memset(&ifr, 0, sizeof(ifr));
+		strcpy(ifr.name, ifname);
+		mini_syscall(SYS_ioctl, s, 0xc0206911 /* SIOCGIFFLAGS */, (long)&ifr, 0, 0, 0);
+		ifr.u.flags |= 0x0041; /* IFF_UP | IFF_RUNNING */
+		mini_syscall(SYS_ioctl, s, 0x80206910 /* SIOCSIFFLAGS */, (long)&ifr, 0, 0, 0);
+		close(s);
+	}
+
+	/* 2. Open BPF descriptor */
+	int bpf = -1;
+	const char *bpf_devs[] = { "/dev/bpf0", "/dev/bpf1", "/dev/bpf2", "/dev/bpf3", NULL };
+	for (int i = 0; bpf_devs[i]; i++) {
+		bpf = open(bpf_devs[i], O_RDWR, 0);
+		if (bpf >= 0) break;
+	}
+	if (bpf < 0) {
+		printf("dhcp: cannot open /dev/bpf (errno %d)\n", errno);
+		return;
+	}
+
+	/* Bind BPF to interface */
+	struct {
+		char ifr_name[16];
+		char pad[16];
+	} bpf_ifr;
+	memset(&bpf_ifr, 0, sizeof(bpf_ifr));
+	strcpy(bpf_ifr.ifr_name, ifname);
+	long ret = mini_syscall(SYS_ioctl, bpf, 0x8020426c /* BIOCSETIF */, (long)&bpf_ifr, 0, 0, 0);
+	if (ret != 0) {
+		printf("dhcp: BIOCSETIF on %s failed (%ld, errno %d)\n", ifname, ret, errno);
+		close(bpf);
+		return;
+	}
+
+	int one = 1;
+	mini_syscall(SYS_ioctl, bpf, 0x80044270 /* BIOCIMMEDIATE */, (long)&one, 0, 0, 0);
+	mini_syscall(SYS_ioctl, bpf, 0x80044275 /* BIOCSHDRCMPLT */, (long)&one, 0, 0, 0);
+	int zero = 0;
+	mini_syscall(SYS_ioctl, bpf, 0x80044277 /* BIOCSSEESENT */, (long)&zero, 0, 0, 0);
+
+	uint32_t xid = 0x3990beef;
+	static const uint8_t client_mac[6] = { 0x00, 0x0a, 0xf5, 0x39, 0x90, 0x01 };
+
+	printf("[DHCP] Starting DHCP negotiation on %s (WCN3990)...\n", ifname);
+	printf("[DHCP] Broadcasting DHCPDISCOVER (xid 0x%08x)...\n", xid);
+
+	uint8_t tx_frame[512];
+	size_t tx_len = 0;
+	picasso_build_dhcp_frame(tx_frame, &tx_len, client_mac, xid, 1 /* DHCPDISCOVER */, NULL, NULL);
+
+	ssize_t nw = write(bpf, tx_frame, tx_len);
+	if (nw <= 0) {
+		printf("dhcp: write to BPF failed (%ld, errno %d)\n", (long)nw, errno);
+		close(bpf);
+		return;
+	}
+
+	/* Get exact BPF buffer size required by Darwin */
+	uint32_t bpf_bufsize = 4096;
+	mini_syscall(SYS_ioctl, bpf, 0x40044266 /* BIOCGBLEN */, (long)&bpf_bufsize, 0, 0, 0);
+	if (bpf_bufsize == 0 || bpf_bufsize > 65536) bpf_bufsize = 4096;
+
+	static uint8_t rx_buf[65536];
+	uint8_t yi[4] = { 0, 0, 0, 0 };
+	uint8_t server_id[4] = { 10, 14, 42, 1 };
+	uint8_t off_mask[4] = { 255, 255, 254, 0 };
+	uint8_t off_router[4] = { 10, 14, 42, 1 };
+	uint8_t off_dns[4] = { 10, 14, 2, 2 };
+	char domain_name[64]; domain_name[0] = 0;
+
+	/* Wait for DHCPOFFER */
+	if (picasso_wait_dhcp_reply(bpf, bpf_bufsize, rx_buf, xid, 2 /* DHCPOFFER */,
+	                            yi, server_id, off_mask, off_router, off_dns, domain_name) < 0) {
+		printf("dhcp: timeout waiting for DHCPOFFER\n");
+		close(bpf);
+		return;
+	}
+
+	printf("[DHCP] Received DHCPOFFER from %u.%u.%u.%u:\n",
+	       server_id[0], server_id[1], server_id[2], server_id[3]);
+	printf("       Offered IP: %u.%u.%u.%u\n", yi[0], yi[1], yi[2], yi[3]);
+	printf("       Subnet:     %u.%u.%u.%u\n", off_mask[0], off_mask[1], off_mask[2], off_mask[3]);
+	printf("       Gateway:    %u.%u.%u.%u\n", off_router[0], off_router[1], off_router[2], off_router[3]);
+	printf("       DNS Server: %u.%u.%u.%u\n", off_dns[0], off_dns[1], off_dns[2], off_dns[3]);
+	if (domain_name[0]) printf("       Domain:     %s\n", domain_name);
+
+	/* Build and send DHCPREQUEST */
+	printf("[DHCP] Sending DHCPREQUEST for %u.%u.%u.%u...\n", yi[0], yi[1], yi[2], yi[3]);
+	picasso_build_dhcp_frame(tx_frame, &tx_len, client_mac, xid, 3 /* DHCPREQUEST */, yi, server_id);
+	write(bpf, tx_frame, tx_len);
+
+	/* Wait for DHCPACK */
+	if (picasso_wait_dhcp_reply(bpf, bpf_bufsize, rx_buf, xid, 5 /* DHCPACK */,
+	                            yi, server_id, off_mask, off_router, off_dns, domain_name) < 0) {
+		printf("dhcp: timeout waiting for DHCPACK\n");
+		close(bpf);
+		return;
+	}
+
+	close(bpf);
+
+	/* Configure interface with leased IP and netmask */
+	s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 0);
+	if (s >= 0) {
+		struct {
+			char name[16];
+			union {
+				struct {
+					uint8_t  sin_len;
+					uint8_t  sin_family;
+					uint16_t sin_port;
+					uint32_t sin_addr;
+					char     sin_zero[8];
+				} sin;
+				short flags;
+				char pad[16];
+			} u;
+		} ifr_cfg;
+
+		memset(&ifr_cfg, 0, sizeof(ifr_cfg));
+		strcpy(ifr_cfg.name, ifname);
+		ifr_cfg.u.sin.sin_len = 16;
+		ifr_cfg.u.sin.sin_family = 2; /* AF_INET */
+		memcpy(&ifr_cfg.u.sin.sin_addr, yi, 4);
+		mini_syscall(SYS_ioctl, s, 0x8020690c /* SIOCSIFADDR */, (long)&ifr_cfg, 0, 0, 0);
+
+		memset(&ifr_cfg, 0, sizeof(ifr_cfg));
+		strcpy(ifr_cfg.name, ifname);
+		ifr_cfg.u.sin.sin_len = 16;
+		ifr_cfg.u.sin.sin_family = 2;
+		memcpy(&ifr_cfg.u.sin.sin_addr, off_mask, 4);
+		mini_syscall(SYS_ioctl, s, 0x80206916 /* SIOCSIFNETMASK */, (long)&ifr_cfg, 0, 0, 0);
+
+		memset(&ifr_cfg, 0, sizeof(ifr_cfg));
+		strcpy(ifr_cfg.name, ifname);
+		mini_syscall(SYS_ioctl, s, 0xc0206911 /* SIOCGIFFLAGS */, (long)&ifr_cfg, 0, 0, 0);
+		ifr_cfg.u.flags |= 0x0041;
+		mini_syscall(SYS_ioctl, s, 0x80206910 /* SIOCSIFFLAGS */, (long)&ifr_cfg, 0, 0, 0);
+
+		close(s);
+	}
+
+	printf("\n");
+	printf("================== DHCP Configuration ==================\n");
+	printf("  Interface:   %s\n", ifname);
+	printf("  Status:      BOUND (Active Lease)\n");
+	printf("  IP Address:  %u.%u.%u.%u\n", yi[0], yi[1], yi[2], yi[3]);
+	printf("  Subnet Mask: %u.%u.%u.%u\n", off_mask[0], off_mask[1], off_mask[2], off_mask[3]);
+	printf("  Gateway:     %u.%u.%u.%u (default route skipped as requested)\n", off_router[0], off_router[1], off_router[2], off_router[3]);
+	printf("  DNS Server:  %u.%u.%u.%u\n", off_dns[0], off_dns[1], off_dns[2], off_dns[3]);
+	if (domain_name[0]) {
+		printf("  DNS Domain:  %s\n", domain_name);
+	}
+	printf("========================================================\n\n");
+}
