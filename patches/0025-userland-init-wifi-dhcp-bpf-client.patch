+			continue;
+		}
+
+		if (strncmp(cmd, "cd", 2) == 0 && (cmd[2] == ' ' || cmd[2] == 0)) {
+			const char *target = cmd[2] == ' ' ? cmd + 3 : "/";
+			while (*target == ' ') target++;
