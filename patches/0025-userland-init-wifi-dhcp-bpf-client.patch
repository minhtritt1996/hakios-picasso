+static void
+cmd_wifi_connect(const char *ssid, const char *pass)
+{
+	if (!ssid || !*ssid) {
+		printf("Usage: wifi connect <SSID> [password]\n");
+		return;
+	}
+	int s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 0);
+	if (s < 0) {
+		printf("wifi: socket failed: %s\n", strerror(errno));
+		return;
+	}
+
+	printf("Connecting to Wi-Fi '%s' on en0 (WCN3990)...\n", ssid);
+
+	struct apple80211_assoc assoc;
+	memset(&assoc, 0, sizeof(assoc));
+	assoc.version = 1;
+	assoc.ssid_length = strlen(ssid);
+	if (assoc.ssid_length > 32) assoc.ssid_length = 32;
+	memcpy(assoc.ssid, ssid, assoc.ssid_length);
+
+	if (pass && *pass) {
+		assoc.key_cipher = 10; /* CIPHER_PASSPHRASE */
+		assoc.key_length = strlen(pass);
+		if (assoc.key_length > 63) assoc.key_length = 63;
+		memcpy(assoc.key, pass, assoc.key_length);
+	} else {
+		assoc.key_length = 0; /* OPEN */
+	}
+
+	struct apple80211req req;
+	memset(&req, 0, sizeof(req));
+	strcpy(req.req_if_name, "en0");
+	req.req_type = 20; /* ASSOCIATE */
+	req.req_len = sizeof(assoc);
+	req.req_data = (uint64_t)&assoc;
+
+	long ret = mini_syscall(SYS_ioctl, s, 0x802869c8 /* SIOCSA80211 */, (long)&req, 0, 0, 0);
+	if (ret != 0) {
+		printf("wifi connect: associate ioctl failed (%ld, errno %d)\n", ret, errno);
+		close(s);
+		return;
+	}
+
+	/* Wait briefly for sta thread to complete association */
+	usleep(250000);
+
+	memset(&req, 0, sizeof(req));
+	strcpy(req.req_if_name, "en0");
+	req.req_type = 21; /* ASSOCIATE_RESULT */
+	mini_syscall(SYS_ioctl, s, 0xc02869c9 /* SIOCGA80211 */, (long)&req, 0, 0, 0);
+
+	if (req.req_val == 0 || req.req_val == 1) {
+		printf("[OK] Successfully associated with '%s'!\n", ssid);
+		cmd_wifi_status_sock(s);
+	} else {
+		printf("[FAIL] Connection to '%s' failed (status %d)\n", ssid, req.req_val);
+	}
+
+	close(s);
+}
+
+static void
+cmd_wifi_disconnect(void)
+{
+	int s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 0);
+	if (s < 0) {
+		printf("wifi: socket failed: %s\n", strerror(errno));
+		return;
+	}
+
+	struct apple80211req req;
+	memset(&req, 0, sizeof(req));
+	strcpy(req.req_if_name, "en0");
+	req.req_type = 22; /* DISASSOCIATE */
+
+	long ret = mini_syscall(SYS_ioctl, s, 0x802869c8 /* SIOCSA80211 */, (long)&req, 0, 0, 0);
+	if (ret == 0) {
+		printf("[OK] Disconnected from Wi-Fi network on en0\n");
+	} else {
+		printf("wifi disconnect: failed (%ld, errno %d)\n", ret, errno);
+			printf("    wifi dhcp                - acquire DHCP lease on en0\n");
+	}
+	close(s);
+}
