+static void
+cmd_wifi_status_sock(int s)
+{
+	struct apple80211req req;
+	memset(&req, 0, sizeof(req));
+	strcpy(req.req_if_name, "en0");
+	req.req_type = 13; /* STATE */
+	long ret = mini_syscall(SYS_ioctl, s, 0xc02869c9 /* SIOCGA80211 */, (long)&req, 0, 0, 0);
+	if (ret != 0) {
+		printf("wifi status: failed to get state (%ld, errno %d)\n", ret, errno);
+		return;
+	}
+
+	int state = req.req_val;
+	const char *state_str = "DISCONNECTED (IDLE)";
+	if (state == 4) state_str = "CONNECTED (RUN)";
+	else if (state == 2) state_str = "AUTHENTICATING (JOINING)";
+	else if (state == 1) state_str = "SCANNING";
+
+	printf("\n================ Wi-Fi Status (en0) ================\n");
+	printf("  Hardware:  Qualcomm WCN3990 (Darwin 802.11)\n");
+	printf("  State:     %s\n", state_str);
+
+	if (state == 4) {
+		char ssid[33];
+		memset(ssid, 0, sizeof(ssid));
+		memset(&req, 0, sizeof(req));
+		strcpy(req.req_if_name, "en0");
+		req.req_type = 1; /* SSID */
+		req.req_len = sizeof(ssid) - 1;
+		req.req_data = (uint64_t)ssid;
+		if (mini_syscall(SYS_ioctl, s, 0xc02869c9, (long)&req, 0, 0, 0) == 0) {
+			printf("  SSID:      %s\n", ssid);
+		}
+
+		uint8_t bssid[6];
+		memset(bssid, 0, sizeof(bssid));
+		memset(&req, 0, sizeof(req));
+		strcpy(req.req_if_name, "en0");
+		req.req_type = 9; /* BSSID */
+		req.req_len = 6;
+		req.req_data = (uint64_t)bssid;
+		if (mini_syscall(SYS_ioctl, s, 0xc02869c9, (long)&req, 0, 0, 0) == 0) {
+			printf("  BSSID:     %02x:%02x:%02x:%02x:%02x:%02x\n",
+			       bssid[0], bssid[1], bssid[2], bssid[3], bssid[4], bssid[5]);
+		}
+
+		struct { uint32_t version; struct apple80211_channel channel; } ch;
+		memset(&ch, 0, sizeof(ch));
+		memset(&req, 0, sizeof(req));
+		strcpy(req.req_if_name, "en0");
+		req.req_type = 4; /* CHANNEL */
+		req.req_len = sizeof(ch);
+		req.req_data = (uint64_t)&ch;
+		if (mini_syscall(SYS_ioctl, s, 0xc02869c9, (long)&req, 0, 0, 0) == 0) {
+			printf("  Channel:   %d (%s)\n", ch.channel.channel,
+			       ch.channel.channel > 14 ? "5 GHz" : "2.4 GHz");
+		}
+
+		struct { uint32_t version, radios, unit; int32_t each[4], all, each_ext[4], all_ext; } rssi_info;
+		memset(&rssi_info, 0, sizeof(rssi_info));
+		memset(&req, 0, sizeof(req));
+		strcpy(req.req_if_name, "en0");
+		req.req_type = 16; /* RSSI */
+		req.req_len = sizeof(rssi_info);
+		req.req_data = (uint64_t)&rssi_info;
+		if (mini_syscall(SYS_ioctl, s, 0xc02869c9, (long)&req, 0, 0, 0) == 0) {
+			printf("  Signal:    %d dBm\n", rssi_info.all);
+		}
+	}
+	printf("====================================================\n\n");
+}
