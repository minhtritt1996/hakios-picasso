+			printf("    ifconfig en0 <ip> [netmask <mask>] [up] - configure interface IP\n");
+			printf("    dhcp [ifname]            - obtain dynamic IP via DHCP client (default en0)\n");
+			printf("    wifi status              - show WCN3990 association, SSID, signal\n");
