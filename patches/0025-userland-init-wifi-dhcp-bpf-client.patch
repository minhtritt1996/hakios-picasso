+
+	for (;;) {
+		printf("\033[1;32mroot@hakios-picasso\033[0m:\033[1;34m%s\033[0m# ", shell_cwd);
+		ssize_t n = read(0, line, sizeof(line) - 1);
+		if (n <= 0) {
+			usleep(50000);
+			continue;
+		}
+		line[n] = 0;
+		while (n > 0 && (line[n - 1] == '\r' || line[n - 1] == '\n')) {
+			line[--n] = 0;
