+static char shell_cwd[256] = "/";
+
+static void
+update_cwd(const char *path)
+{
+	if (!path || !*path) {
+		return;
+	}
+	if (strcmp(path, ".") == 0) {
+		return;
+	}
+	if (strcmp(path, "..") == 0) {
+		char *last = NULL;
+		for (char *p = shell_cwd; *p; p++) {
+			if (*p == '/') last = p;
+		}
+		if (last && last != shell_cwd) {
+			*last = 0;
+		} else if (last == shell_cwd) {
+			shell_cwd[1] = 0;
+		}
+		return;
+	}
+	if (path[0] == '/') {
+		strcpy(shell_cwd, path);
+	} else {
+		size_t l = strlen(shell_cwd);
+		if (l > 0 && shell_cwd[l - 1] != '/') {
+			shell_cwd[l++] = '/';
+			shell_cwd[l] = 0;
+		}
+		strcpy(shell_cwd + l, path);
+	}
+	size_t len = strlen(shell_cwd);
+	if (len > 1 && shell_cwd[len - 1] == '/') {
+		shell_cwd[len - 1] = 0;
+	}
+}
+
+static int
+parse_ipv4(const char *s, uint32_t *out_ip)
+{
+	unsigned int a = 0, b = 0, c = 0, d = 0;
+	while (*s >= '0' && *s <= '9') a = a * 10 + (*s++ - '0');
+	if (*s++ != '.') return -1;
+	while (*s >= '0' && *s <= '9') b = b * 10 + (*s++ - '0');
+	if (*s++ != '.') return -1;
+	while (*s >= '0' && *s <= '9') c = c * 10 + (*s++ - '0');
+	if (*s++ != '.') return -1;
+	while (*s >= '0' && *s <= '9') d = d * 10 + (*s++ - '0');
+	if (a > 255 || b > 255 || c > 255 || d > 255) return -1;
+	*out_ip = (a) | (b << 8) | (c << 16) | (d << 24);
+	return 0;
+}
