diff --git a/userland/src/init.c b/userland/src/init.c
index 6801ce2..229442d 100644
--- a/userland/src/init.c
+++ b/userland/src/init.c
@@ -1437,9 +1437,13 @@ test_time(void)
 	long elapsed;
 
 	printf("\n-- time --\n");
+	printf("HAKIOSI: time: before gettimeofday\n");
 	gettimeofday(&before, NULL);
+	printf("HAKIOSI: time: before usleep\n");
 	usleep(200000);
+	printf("HAKIOSI: time: after usleep\n");
 	gettimeofday(&after, NULL);
+	printf("HAKIOSI: time: after gettimeofday\n");
 	elapsed = (after.tv_sec - before.tv_sec) * 1000 + (after.tv_usec - before.tv_usec) / 1000;
 	printf("  slept 200 ms, the clock advanced %ld ms\n", elapsed);
 	check(elapsed >= 190 && elapsed < 1000, "sleep and wall clock agree");
@@ -1554,13 +1558,18 @@ main(int argc, char **argv, char **envp)
 	test_processes();
 	test_dynamic();
 	test_devices();
+	printf("HAKIOSI: main: devices done\n");
 	test_time();
+	printf("HAKIOSI: main: time done\n");
 
 	printf("\n=== %d checks, %d failed ===\n", checks, failures);
 	/* daemons that do not run as root get the console as their standard error too */
 	chmod("/dev/console", 0666);
+	printf("HAKIOSI: main: configure_inject\n");
 	configure_inject();
+	printf("HAKIOSI: main: configure_vnodes\n");
 	configure_vnodes();
+	printf("HAKIOSI: main: run_rc\n");
 	run_rc(in_image("/etc/rc"));
 	printf("\n=== init: done ===\n");
 	reboot(RB_HALT);
