+static void
+cmd_ifconfig(char *args)
+{
+	int s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 0);
+	if (s < 0) {
+		printf("ifconfig: socket failed: %s\n", strerror(errno));
+		return;
+	}
+
+	char *words[16];
+	int nwords = 0;
+	for (char *p = args; *p && nwords < 15;) {
+		while (*p == ' ' || *p == '\t') p++;
+		if (!*p) break;
+		words[nwords++] = p;
+		while (*p && *p != ' ' && *p != '\t') p++;
+		if (*p) *p++ = 0;
+	}
+	words[nwords] = NULL;
+
+	struct {
+		char name[16];
+		union {
+			struct {
+				uint8_t  sin_len;
+				uint8_t  sin_family;
+				uint16_t sin_port;
+				uint32_t sin_addr;
+				char     sin_zero[8];
+			} sin;
+			short flags;
+			char pad[16];
+		} u;
+	} ifr;
+
+	if (nwords == 0) {
+		const char *names[] = { "lo0", "en0", "en1", NULL };
+		for (int i = 0; names[i]; i++) {
+			memset(&ifr, 0, sizeof(ifr));
+			strcpy(ifr.name, names[i]);
+			long ret = mini_syscall(SYS_ioctl, s, 0xc0206911 /* SIOCGIFFLAGS */, (long)&ifr, 0, 0, 0);
+			if (ret != 0) {
+				continue;
+			}
+			short flags = ifr.u.flags;
+			printf("%s: flags=0x%04x<", names[i], (unsigned short)flags);
+			int first = 1;
+			if (flags & 0x0001) { printf("%sUP", first ? "" : ","); first = 0; }
+			if (flags & 0x0002) { printf("%sBROADCAST", first ? "" : ","); first = 0; }
+			if (flags & 0x0008) { printf("%sLOOPBACK", first ? "" : ","); first = 0; }
+			if (flags & 0x0040) { printf("%sRUNNING", first ? "" : ","); first = 0; }
+			if (flags & 0x0800) { printf("%sSIMPLEX", first ? "" : ","); first = 0; }
+			if (flags & 0x8000) { printf("%sMULTICAST", first ? "" : ","); first = 0; }
+			printf(">\n");
+
+			memset(&ifr, 0, sizeof(ifr));
+			strcpy(ifr.name, names[i]);
+			ret = mini_syscall(SYS_ioctl, s, 0xc0206921 /* SIOCGIFADDR */, (long)&ifr, 0, 0, 0);
+			if (ret == 0 && ifr.u.sin.sin_family == 2) {
+				uint8_t *ip = (uint8_t *)&ifr.u.sin.sin_addr;
+				printf("        inet %u.%u.%u.%u\n", ip[0], ip[1], ip[2], ip[3]);
+			}
+			if (strcmp(names[i], "en0") == 0) {
+				printf("        ether (Qualcomm WCN3990 Wi-Fi)\n");
+			}
+		}
+	} else {
+		/* ifconfig <ifname> <ip> [netmask <mask>] [up] */
+		const char *ifname = words[0];
+		uint32_t ip_val = 0, mask_val = 0;
+		int has_ip = 0, has_mask = 0, bring_up = 0;
+
+		for (int i = 1; i < nwords; i++) {
+			if (strcmp(words[i], "up") == 0) {
+				bring_up = 1;
+			} else if (strcmp(words[i], "netmask") == 0 && i + 1 < nwords) {
+				if (parse_ipv4(words[++i], &mask_val) == 0) has_mask = 1;
+			} else if (!has_ip && parse_ipv4(words[i], &ip_val) == 0) {
+				has_ip = 1;
+			}
+		}
+
+		if (has_ip) {
+			memset(&ifr, 0, sizeof(ifr));
+			strcpy(ifr.name, ifname);
+			ifr.u.sin.sin_len = 16;
+			ifr.u.sin.sin_family = 2; /* AF_INET */
+			ifr.u.sin.sin_addr = ip_val;
+			long ret = mini_syscall(SYS_ioctl, s, 0x8020690c /* SIOCSIFADDR */, (long)&ifr, 0, 0, 0);
+			if (ret != 0) {
+				printf("ifconfig: set %s addr failed: %s\n", ifname, strerror(errno));
+			} else {
+				uint8_t *ip = (uint8_t *)&ip_val;
+				printf("ifconfig: %s inet configured as %u.%u.%u.%u\n", ifname, ip[0], ip[1], ip[2], ip[3]);
+			}
+		}
+		if (has_mask) {
+			memset(&ifr, 0, sizeof(ifr));
+			strcpy(ifr.name, ifname);
+			ifr.u.sin.sin_len = 16;
+			ifr.u.sin.sin_family = 2;
+			ifr.u.sin.sin_addr = mask_val;
+			mini_syscall(SYS_ioctl, s, 0x80206916 /* SIOCSIFNETMASK */, (long)&ifr, 0, 0, 0);
+		}
+		if (bring_up || has_ip) {
+			memset(&ifr, 0, sizeof(ifr));
+			strcpy(ifr.name, ifname);
+			mini_syscall(SYS_ioctl, s, 0xc0206911 /* SIOCGIFFLAGS */, (long)&ifr, 0, 0, 0);
+			ifr.u.flags |= 0x0041; /* IFF_UP | IFF_RUNNING */
+			mini_syscall(SYS_ioctl, s, 0x80206910 /* SIOCSIFFLAGS */, (long)&ifr, 0, 0, 0);
+			printf("ifconfig: %s link is UP\n", ifname);
+		}
+	}
+	close(s);
+}
