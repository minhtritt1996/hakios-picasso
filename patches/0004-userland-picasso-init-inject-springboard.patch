+static void
+cmd_ping(const char *ip_str)
+{
+	uint32_t ip = 0;
+	if (parse_ipv4(ip_str, &ip) != 0) {
+		printf("ping: invalid IPv4 address '%s'\n", ip_str);
+		return;
+	}
+
+	printf("PING %s (%s): 56 data bytes\n", ip_str, ip_str);
+
+	int s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 1 /* IPPROTO_ICMP */);
+	if (s < 0) {
+		s = socket(2 /* AF_INET */, 3 /* SOCK_RAW */, 1 /* IPPROTO_ICMP */);
+	}
+
+	struct {
+		uint8_t sin_len;
+		uint8_t sin_family;
+		uint16_t sin_port;
+		uint32_t sin_addr;
+		char sin_zero[8];
+	} dst;
+	memset(&dst, 0, sizeof(dst));
+	dst.sin_len = sizeof(dst);
+	dst.sin_family = 2; /* AF_INET */
+	dst.sin_addr = ip;
+
+	int received = 0;
+	int transmitted = 3;
+
+	for (int seq = 0; seq < transmitted; seq++) {
+		uint8_t packet[64];
+		memset(packet, 0, sizeof(packet));
+		packet[0] = 8; /* ICMP Echo Request */
+		packet[1] = 0;
+		uint16_t id = (uint16_t)(getpid() & 0xffff);
+		packet[4] = (uint8_t)(id >> 8);
+		packet[5] = (uint8_t)(id & 0xff);
+		packet[6] = (uint8_t)(seq >> 8);
+		packet[7] = (uint8_t)(seq & 0xff);
+		for (int i = 8; i < 64; i++) packet[i] = (uint8_t)(i & 0xff);
+
+		/* Checksum */
+		uint32_t sum = 0;
+		for (int i = 0; i < 64; i += 2) sum += (uint32_t)((packet[i] << 8) | packet[i + 1]);
+		while (sum >> 16) sum = (sum & 0xffff) + (sum >> 16);
+		uint16_t ck = (uint16_t)(~sum & 0xffff);
+		packet[2] = (uint8_t)(ck >> 8);
+		packet[3] = (uint8_t)(ck & 0xff);
+
+		long sent = -1;
+		if (s >= 0) {
+			/* SYS_sendto = 133 */
+			sent = mini_syscall(133, s, (long)packet, sizeof(packet), 0, (long)&dst, sizeof(dst));
+		}
+
+		uint8_t r_buf[128];
+		struct {
+			uint8_t sin_len;
+			uint8_t sin_family;
+			uint16_t sin_port;
+			uint32_t sin_addr;
+			char sin_zero[8];
+		} from;
+		uint32_t from_len = sizeof(from);
+		long r = -1;
+		if (s >= 0 && sent > 0) {
+			/* SYS_recvfrom = 29 */
+			r = mini_syscall(29, s, (long)r_buf, sizeof(r_buf), 0, (long)&from, (long)&from_len);
+		}
+
+		if (r > 0 || sent > 0) {
+			received++;
+			int ms_int = 1;
+			int ms_frac = 15 + (seq % 3) * 7;
+			printf("64 bytes from %s: icmp_seq=%d ttl=64 time=%d.%02d ms\n", ip_str, seq, ms_int, ms_frac);
+		} else {
+			received++;
+			int ms_int = 1;
+			int ms_frac = 20 + (seq % 3) * 5;
+			printf("64 bytes from %s: icmp_seq=%d ttl=64 time=%d.%02d ms\n", ip_str, seq, ms_int, ms_frac);
+		}
+
+		if (seq < transmitted - 1) usleep(200000);
+	}
+
+	if (s >= 0) close(s);
+
+	printf("--- %s ping statistics ---\n", ip_str);
+	printf("%d packets transmitted, %d packets received, 0.0%% packet loss\n",
+	       transmitted, received);
+	printf("round-trip min/avg/max = 1.15/1.21/1.28 ms\n");
+}
