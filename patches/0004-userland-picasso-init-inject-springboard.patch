+				int p_idx = 0;
+				while (*p && *p != ' ' && p_idx < 64) {
+					pass[p_idx++] = *p++;
+				}
+				pass[p_idx] = 0;
+				cmd_wifi_connect(ssid, pass[0] ? pass : NULL);
+			} else if (strcmp(sub, "disconnect") == 0) {
+				cmd_wifi_disconnect();
+			} else if (strcmp(sub, "dhcp") == 0) {
+				cmd_dhcp("en0");
+			} else {
+				printf("Usage: wifi [scan|status|connect <SSID> [password]|disconnect]\n");
+			}
+			continue;
+		}
+
+		if (strcmp(cmd, "scan") == 0) {
+			cmd_wifi_scan();
+			continue;
+		}
+
+		if (strncmp(cmd, "bt", 2) == 0 && (cmd[2] == ' ' || cmd[2] == 0)) {
+			char *sub = cmd[2] == ' ' ? cmd + 3 : "";
+			while (*sub == ' ') sub++;
