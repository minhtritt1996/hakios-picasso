+static void
+setup_primary_display_descriptor(void)
+{
+	uint8_t *desc = (uint8_t *)(0x1e22893d8UL + slide);
+	uint32_t *current = (uint32_t *)(0x1e22893a8UL + slide);
+	uint32_t *expect = (uint32_t *)(0x1e22893ccUL + slide);
+	uint32_t *count = (uint32_t *)(0x1e2289dd8UL + slide);
+	void **list = (void **)(0x1e2289de0UL + slide);
+	io_service_t service;
+
+	io_registry_entry_t chosen = IORegistryEntryFromPath(0, "IODeviceTree:/chosen");
+	if (chosen != 0) {
+		CFDataRef dinfo = (CFDataRef)IORegistryEntryCreateCFProperty(chosen, CFSTR("fb-debug-info"), kCFAllocatorDefault, 0);
+		if (dinfo != NULL) {
+			const uint32_t *p = (const uint32_t *)CFDataGetBytePtr(dinfo);
+			say("hakios: /chosen fb-debug-info: %ux%u depth=%u base_ok=%u code=%#x\n", p[0], p[1], p[2], p[3], p[4]);
+			CFRelease(dinfo);
+		} else {
+			say("hakios: /chosen fb-debug-info NOT FOUND\n");
+		}
+		CFDataRef dbad = (CFDataRef)IORegistryEntryCreateCFProperty(chosen, CFSTR("fb-vinfo-bad"), kCFAllocatorDefault, 0);
+		if (dbad != NULL) {
+			const uint32_t *p = (const uint32_t *)CFDataGetBytePtr(dbad);
+			say("hakios: /chosen fb-vinfo-bad: %ux%u depth=%u base_ok=%u\n", p[0], p[1], p[2], p[3]);
+			CFRelease(dbad);
+		}
+		CFTypeRef dreg = IORegistryEntryCreateCFProperty(chosen, CFSTR("fb-registered"), kCFAllocatorDefault, 0);
+		say("hakios: /chosen fb-registered: %s\n", dreg != NULL ? "YES" : "NO");
+		if (dreg != NULL) CFRelease(dreg);
+		IOObjectRelease(chosen);
+	}
+
+	io_registry_entry_t reg_dt = IORegistryEntryFromPath(0, "IODeviceTree:/arm-io/disp0");
+	io_registry_entry_t reg_plane = IORegistryEntryFromPath(0, "IOService:/disp0");
+	say("hakios: probe reg entries: dt=%#x, plane=%#x\n", reg_dt, reg_plane);
+	if (reg_dt != 0) IOObjectRelease(reg_dt);
+	if (reg_plane != 0) IOObjectRelease(reg_plane);
+
+	io_iterator_t it = 0;
+	if (IOServiceGetMatchingServices(0, IOServiceMatching("IOService"), &it) == KERN_SUCCESS) {
+		io_service_t s;
+		int idx = 0;
+		while ((s = IOIteratorNext(it)) != 0) {
+			io_name_t sname = {0}, scls = {0};
+			IORegistryEntryGetName(s, sname);
+			IOObjectGetClass(s, scls);
+			say("hakios: reg[%d]: name='%s' class='%s' id=%#x\n", idx++, sname, scls, s);
+			IOObjectRelease(s);
+		}
+		IOObjectRelease(it);
+	}
+
+	service = IOServiceGetMatchingService(0, IOServiceMatching("IOMobileFramebuffer"));
+	if (service == 0) {
+		service = IOServiceGetMatchingService(0, IOServiceNameMatching("disp0"));
+	}
+	if (service == 0) {
+		service = IOServiceGetMatchingService(0, IOServiceMatching("IOPlatformDevice"));
+	}
+
+	*(CFStringRef *)(desc + 0x00) = CFSTR("primary");
+	*(uint32_t *)(desc + 0x08) = 0; /* display type: 0 = primary */
+	*(uint32_t *)(desc + 0x10) = 1; /* display ID: 1 (matches CAWindowServer displayWithDisplayId:1) */
+	*(io_service_t *)(desc + 0x14) = service;
+	strncpy((char *)(desc + 0x18), "primary", 128);
+	*(uint8_t *)(desc + 0x98) = 0; /* is_virtual = 0 */
+
+	list[0] = desc;
+	*count = 1;
+	*expect = 1;
+	*current = 1;
+	io_name_t clsname = {0};
+	if (service != 0) {
+		IOObjectGetClass(service, clsname);
+	}
+	say("hakios: display descriptor 0 populated (service %#x, class '%s', primary, count 1)\n", service, clsname);
+
+	/* Probe IOMobileFramebuffer user client and framework opening */
+	if (service != 0) {
+		io_connect_t conn = 0;
+		kern_return_t kr = IOServiceOpen(service, mach_task_self(), 0, &conn);
+		say("hakios: probe IOServiceOpen(service=%#x, type=0) -> %#x (conn=%#x)\n", service, kr, conn);
+		if (conn != 0) {
+			IOServiceClose(conn);
+		}
+	}
+	kern_return_t (*pIOMFBOpen)(io_service_t, task_port_t, unsigned int, void **) =
+		(kern_return_t (*)(io_service_t, task_port_t, unsigned int, void **))dlsym(RTLD_DEFAULT, "IOMobileFramebufferOpen");
+	kern_return_t (*pIOMFBOpenByName)(CFStringRef, void **) =
+		(kern_return_t (*)(CFStringRef, void **))dlsym(RTLD_DEFAULT, "IOMobileFramebufferOpenByName");
+
+	if (pIOMFBOpen != NULL && service != 0) {
+		void *fb = NULL;
+		kern_return_t kr = pIOMFBOpen(service, mach_task_self(), 0, &fb);
+		say("hakios: probe IOMobileFramebufferOpen(service=%#x) -> %#x (fb=%p)\n", service, kr, fb);
+	}
+	if (pIOMFBOpenByName != NULL) {
+		void *fb = NULL;
+		kern_return_t kr = pIOMFBOpenByName(CFSTR("primary"), &fb);
+		say("hakios: probe IOMobileFramebufferOpenByName('primary') -> %#x (fb=%p)\n", kr, fb);
+	}
+}
