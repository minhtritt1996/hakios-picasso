+static void
+dismiss_boot_ui(void)
+{
+	say("hakios: dismiss_boot_ui called\n");
+	if (g_bootUIPresenter != nil) {
+		say("hakios: dismiss_boot_ui on presenter %p\n", g_bootUIPresenter);
+
+		/* 1. Call dismissOverlayWithAnimationSettings:requstedByPID: */
+		SEL s_disp = sel_registerName("dismissOverlayWithAnimationSettings:requstedByPID:");
+		if (class_getInstanceMethod(object_getClass(g_bootUIPresenter), s_disp)) {
+			((void (*)(id, SEL, id, int))objc_msgSend)(g_bootUIPresenter, s_disp, nil, 0);
+			say("hakios: dismissOverlayWithAnimationSettings:requstedByPID: called\n");
+		}
+
+		/* 2. Dismiss overlay directly if present */
+		SEL s_ov = sel_registerName("overlay");
+		if (class_getInstanceMethod(object_getClass(g_bootUIPresenter), s_ov)) {
+			id ov = ((id (*)(id, SEL))objc_msgSend)(g_bootUIPresenter, s_ov);
+			if (ov != nil) {
+				say("hakios: presenter overlay %p found, dismissing directly\n", ov);
+				SEL s_dis = sel_registerName("dismissWithAnimationSettings:");
+				if (class_getInstanceMethod(object_getClass(ov), s_dis)) {
+					((void (*)(id, SEL, id))objc_msgSend)(ov, s_dis, nil);
+					say("hakios: presenter overlay dismissed\n");
+				}
+			}
+		}
+
+		/* 3. Dismiss underlay directly if present */
+		SEL s_un = sel_registerName("underlay");
+		if (class_getInstanceMethod(object_getClass(g_bootUIPresenter), s_un)) {
+			id un = ((id (*)(id, SEL))objc_msgSend)(g_bootUIPresenter, s_un);
+			if (un != nil) {
+				say("hakios: presenter underlay %p found, dismissing directly\n", un);
+				SEL s_dis = sel_registerName("dismissWithAnimationSettings:");
+				if (class_getInstanceMethod(object_getClass(un), s_dis)) {
+					((void (*)(id, SEL, id))objc_msgSend)(un, s_dis, nil);
+					say("hakios: presenter underlay dismissed\n");
+				}
+			}
+		}
+
+		/* 4. Query _renderOverlayManager and remove all active overlays */
+		Ivar iv_mgr = class_getInstanceVariable(object_getClass(g_bootUIPresenter), "_renderOverlayManager");
+		if (iv_mgr) {
+			id mgr = object_getIvar(g_bootUIPresenter, iv_mgr);
+			if (mgr != nil) {
+				say("hakios: renderOverlayManager %p found\n", mgr);
+				SEL s_active = sel_registerName("activeOverlays");
+				SEL s_remove = sel_registerName("removeOverlay:withAnimationSettings:");
+				if (class_getInstanceMethod(object_getClass(mgr), s_active) &&
+				    class_getInstanceMethod(object_getClass(mgr), s_remove)) {
+					id active = ((id (*)(id, SEL))objc_msgSend)(mgr, s_active);
+					if (active) {
+						SEL s_all = sel_registerName("allObjects");
+						if (class_getInstanceMethod(object_getClass(active), s_all)) {
+							active = ((id (*)(id, SEL))objc_msgSend)(active, s_all);
+						}
+					}
+					SEL s_cnt = sel_registerName("count");
+					SEL s_objAt = sel_registerName("objectAtIndex:");
+					if (active && class_getInstanceMethod(object_getClass(active), s_cnt) &&
+					    class_getInstanceMethod(object_getClass(active), s_objAt)) {
+						unsigned long cnt = ((unsigned long (*)(id, SEL))objc_msgSend)(active, s_cnt);
+						say("hakios: renderOverlayManager active overlays count: %lu\n", cnt);
+						for (unsigned long i = 0; i < cnt; i++) {
+							id ov = ((id (*)(id, SEL, unsigned long))objc_msgSend)(active, s_objAt, i);
+							if (ov != nil) {
+								say("hakios: removing overlay %p from manager\n", ov);
+								((void (*)(id, SEL, id, id))objc_msgSend)(mgr, s_remove, ov, nil);
+								SEL s_dis = sel_registerName("dismissWithAnimationSettings:");
+								if (class_getInstanceMethod(object_getClass(ov), s_dis)) {
+									((void (*)(id, SEL, id))objc_msgSend)(ov, s_dis, nil);
+								}
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+}
