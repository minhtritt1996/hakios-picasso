+static void
+cmd_wifi_status(void)
+{
+	int s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 0);
+	if (s < 0) {
+		printf("wifi: socket failed: %s\n", strerror(errno));
+		return;
+	}
+	cmd_wifi_status_sock(s);
+	close(s);
+}
+
+static void
+cmd_wifi_scan(void)
+{
+	int s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 0);
+	if (s < 0) {
+		printf("wifi: socket failed: %s\n", strerror(errno));
+		return;
+	}
+
+	printf("Scanning for Wi-Fi networks on en0 (Qualcomm WCN3990)...\n");
+
+	struct apple80211_scan_request sreq;
+	memset(&sreq, 0, sizeof(sreq));
+	sreq.version = 1;
+	sreq.scan_type = 1;
+	sreq.dwell_ms = 100;
+
+	struct apple80211req req;
+	memset(&req, 0, sizeof(req));
+	strcpy(req.req_if_name, "en0");
+	req.req_type = 10; /* SCAN_REQ */
+	req.req_len = sizeof(sreq);
+	req.req_data = (uint64_t)&sreq;
+
+	long ret = mini_syscall(SYS_ioctl, s, 0x802869c8 /* SIOCSA80211 */, (long)&req, 0, 0, 0);
+	if (ret != 0) {
+		printf("wifi: scan request failed (%ld, errno %d)\n", ret, errno);
+		close(s);
+		return;
+	}
+
+	/* Wait for sta thread to complete scan */
+	for (int wait_i = 0; wait_i < 30; wait_i++) {
+		usleep(100000);
+		memset(&req, 0, sizeof(req));
+		strcpy(req.req_if_name, "en0");
+		req.req_type = 13; /* STATE */
+		if (mini_syscall(SYS_ioctl, s, 0xc02869c9, (long)&req, 0, 0, 0) == 0) {
+			if (req.req_val != 1 /* 1 = SCANNING */) {
+				break;
+			}
+		}
+	}
+
+	printf("\n%-4s  %-22s  %-17s  %-5s  %-9s  %s\n", "NUM", "SSID", "BSSID", "CHAN", "RSSI", "SECURITY");
+	printf("-----------------------------------------------------------------------\n");
+
+	int count = 0;
+	for (;;) {
+		struct apple80211_scan_result res;
+		memset(&res, 0, sizeof(res));
+		res.elements_length = sizeof(res.elements);
+
+		memset(&req, 0, sizeof(req));
+		strcpy(req.req_if_name, "en0");
+		req.req_type = 11; /* SCAN_RESULT */
+		req.req_len = sizeof(res);
+		req.req_data = (uint64_t)&res;
+
+		ret = mini_syscall(SYS_ioctl, s, 0xc02869c9 /* SIOCGA80211 */, (long)&req, 0, 0, 0);
+		if (ret != 0) {
+			break;
+		}
+
+		char ssid_buf[33];
+		int slen = res.ssid_length <= 32 ? res.ssid_length : 32;
+		memcpy(ssid_buf, res.ssid, slen);
+		ssid_buf[slen] = 0;
+
+		const char *sec = "OPEN";
+		for (unsigned pos = 0; pos + 2 <= res.elements_length; ) {
+			uint8_t elem_id = res.elements[pos];
+			uint8_t elem_len = res.elements[pos + 1];
+			if (pos + 2 + elem_len > res.elements_length) break;
+			if (elem_id == 48) { /* RSN / WPA2 */
+				sec = "WPA2-PSK";
+			}
+			pos += 2 + elem_len;
+		}
+
+		count++;
+		printf("[%2d]  %-22s  %02x:%02x:%02x:%02x:%02x:%02x  %-5d  %4d dBm  %s\n",
+		       count,
+		       ssid_buf[0] ? ssid_buf : "<hidden>",
+		       res.bssid[0], res.bssid[1], res.bssid[2],
+		       res.bssid[3], res.bssid[4], res.bssid[5],
+		       res.channel.channel,
+		       res.rssi,
+		       sec);
+	}
+
+	printf("-----------------------------------------------------------------------\n");
+	printf("Discovered %d Wi-Fi network(s)\n\n", count);
+
+	close(s);
+}
+
+static void
+cmd_wifi_connect(const char *ssid, const char *pass)
+{
+	if (!ssid || !*ssid) {
+		printf("Usage: wifi connect <SSID> [password]\n");
+		return;
+	}
+	int s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 0);
+	if (s < 0) {
+		printf("wifi: socket failed: %s\n", strerror(errno));
+		return;
+	}
+
+	printf("Connecting to Wi-Fi '%s' on en0 (WCN3990)...\n", ssid);
+
+	struct apple80211_assoc assoc;
+	memset(&assoc, 0, sizeof(assoc));
+	assoc.version = 1;
+	assoc.ssid_length = strlen(ssid);
+	if (assoc.ssid_length > 32) assoc.ssid_length = 32;
+	memcpy(assoc.ssid, ssid, assoc.ssid_length);
+
+	if (pass && *pass) {
+		assoc.key_cipher = 10; /* CIPHER_PASSPHRASE */
+		assoc.key_length = strlen(pass);
+		if (assoc.key_length > 63) assoc.key_length = 63;
+		memcpy(assoc.key, pass, assoc.key_length);
+	} else {
+		assoc.key_length = 0; /* OPEN */
+	}
+
+	struct apple80211req req;
+	memset(&req, 0, sizeof(req));
+	strcpy(req.req_if_name, "en0");
+	req.req_type = 20; /* ASSOCIATE */
+	req.req_len = sizeof(assoc);
+	req.req_data = (uint64_t)&assoc;
+
+	long ret = mini_syscall(SYS_ioctl, s, 0x802869c8 /* SIOCSA80211 */, (long)&req, 0, 0, 0);
+	if (ret != 0) {
+		printf("wifi connect: associate ioctl failed (%ld, errno %d)\n", ret, errno);
+		close(s);
+		return;
+	}
+
+	/* Wait briefly for sta thread to complete association */
+	usleep(250000);
+
+	memset(&req, 0, sizeof(req));
+	strcpy(req.req_if_name, "en0");
+	req.req_type = 21; /* ASSOCIATE_RESULT */
+	mini_syscall(SYS_ioctl, s, 0xc02869c9 /* SIOCGA80211 */, (long)&req, 0, 0, 0);
+
+	if (req.req_val == 0 || req.req_val == 1) {
+		printf("[OK] Successfully associated with '%s'!\n", ssid);
+		cmd_wifi_status_sock(s);
+	} else {
+		printf("[FAIL] Connection to '%s' failed (status %d)\n", ssid, req.req_val);
+	}
+
+	close(s);
+}
+
+static void
+cmd_wifi_disconnect(void)
+{
+	int s = socket(2 /* AF_INET */, 2 /* SOCK_DGRAM */, 0);
+	if (s < 0) {
+		printf("wifi: socket failed: %s\n", strerror(errno));
+		return;
+	}
+
+	struct apple80211req req;
+	memset(&req, 0, sizeof(req));
+	strcpy(req.req_if_name, "en0");
+	req.req_type = 22; /* DISASSOCIATE */
+
+	long ret = mini_syscall(SYS_ioctl, s, 0x802869c8 /* SIOCSA80211 */, (long)&req, 0, 0, 0);
+	if (ret == 0) {
+		printf("[OK] Disconnected from Wi-Fi network on en0\n");
+	} else {
+		printf("wifi disconnect: failed (%ld, errno %d)\n", ret, errno);
+			printf("    wifi dhcp                - acquire DHCP lease on en0\n");
+	}
+	close(s);
+}
