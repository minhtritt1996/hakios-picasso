+static void
+interactive_shell(void)
+{
+	char line[512];
+
+	printf("\n");
+	printf("======================================================================\n");
+	printf("   Darwin 22.5.0 Darwin Kernel (arm64) - HakiOS Picasso (SM7250)      \n");
+	printf("   Root Console (USB CDC-ACM Serial) - uid: 0 (root)                 \n");
+	printf("======================================================================\n");
+	printf("Type 'help' for built-in commands or execute any binary.\n\n");
+
+	for (;;) {
+		printf("\033[1;32mroot@hakios-picasso\033[0m:\033[1;34m%s\033[0m# ", shell_cwd);
+		ssize_t n = read(0, line, sizeof(line) - 1);
+		if (n <= 0) {
+			usleep(50000);
+			continue;
+		}
+		line[n] = 0;
+		while (n > 0 && (line[n - 1] == '\r' || line[n - 1] == '\n')) {
+			line[--n] = 0;
+		}
+
+		/* Skip leading spaces */
+		char *cmd = line;
+		while (*cmd == ' ' || *cmd == '\t') {
+			cmd++;
+		}
+		if (*cmd == 0) {
+			continue;
+		}
+
+		if (strcmp(cmd, "help") == 0) {
+			printf("HakiOS Root Shell Commands:\n");
+			printf("  Navigation & Files:\n");
+			printf("    pwd                      - print current working directory\n");
