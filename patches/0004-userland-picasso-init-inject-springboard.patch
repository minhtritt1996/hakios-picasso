+static void
+interactive_shell(void)
+{
+	char line[512];
+
+	/* Ignore SIGPIPE (13) so broken sockets never kill the root shell */
+	uint32_t sig_mask = (1u << 12); /* SIGPIPE = 13 */
+	mini_syscall(48 /* SYS_sigprocmask */, 1 /* SIG_BLOCK */, (long)&sig_mask, 0, 0, 0, 0);
+
+	printf("\n");
+	printf("======================================================================\n");
+	printf("   Darwin 22.5.0 Darwin Kernel (arm64) - HakiOS Picasso (SM7250)      \n");
+	printf("   Root Console (USB CDC-ACM Serial) - uid: 0 (root)                 \n");
+	printf("======================================================================\n");
+	printf("Type 'help' for built-in commands or execute any binary.\n\n");
+
+	int show_prompt = 1;
+	for (;;) {
+		if (show_prompt) {
+			printf("\033[1;32mroot@hakios-picasso\033[0m:\033[1;34m%s\033[0m# ", shell_cwd);
+			show_prompt = 0;
+		}
+		ssize_t n = read(0, line, sizeof(line) - 1);
+		if (n <= 0) {
+			if (n == 0) {
+				close(0);
+				int new_fd = open("/dev/console", O_RDWR, 0);
+				if (new_fd >= 0) {
+					if (new_fd != 0) {
+						dup2(new_fd, 0);
+						close(new_fd);
+					}
+				}
+			}
+			usleep(200000);
+			continue;
+		}
+		show_prompt = 1;
+		line[n] = 0;
+		while (n > 0 && (line[n - 1] == '\r' || line[n - 1] == '\n')) {
+			line[--n] = 0;
+		}
+
+		/* Skip leading spaces */
+		char *cmd = line;
+		while (*cmd == ' ' || *cmd == '\t') {
+			cmd++;
+		}
+		if (*cmd == 0) {
+			continue;
+		}
+
+		if (strcmp(cmd, "help") == 0) {
+			printf("HakiOS Root Shell Commands:\n");
+			printf("  Navigation & Files:\n");
+			printf("    pwd                      - print current working directory\n");
+			printf("    cd [path]                - change working directory\n");
+			printf("    ls [path]                - list directory contents\n");
+			printf("    cat <file>               - display contents of file\n");
+			printf("    echo [args] [>|>> file]  - display text or write to file\n");
+			printf("    touch <file>             - create an empty file\n");
+			printf("    mkdir <dir>              - create a directory\n");
+			printf("    rm <file>                - delete a file\n");
+			printf("    rmdir <dir>              - remove an empty directory\n");
+			printf("  System & Status:\n");
+			printf("    uname [-a]               - print system operating kernel info\n");
+			printf("    whoami / id              - display current user credentials\n");
+			printf("    hostname                 - display system host name\n");
+			printf("    uptime / date            - display system uptime and time\n");
+			printf("    ps                       - list processes (/bin/ps -A)\n");
+			printf("    df                       - show filesystem disk space (/bin/df -h)\n");
+			printf("    clear                    - clear terminal screen\n");
+			printf("  Networking (WCN3990 Wi-Fi):\n");
+			printf("    ifconfig                 - show lo0, en0 (Wi-Fi), en1 status & IPs\n");
+			printf("    ifconfig en0 <ip> [netmask <mask>] [up] - configure interface IP\n");
+			printf("    dhcp [ifname]            - obtain dynamic IP via DHCP client (default en0)\n");
+			printf("    wifi status              - show WCN3990 association, SSID, signal\n");
+			printf("    wifi scan                - scan for nearby 802.11 Wi-Fi networks\n");
+			printf("    wifi connect <SSID> [password] - connect to Wi-Fi network\n");
+			printf("    wifi disconnect          - disconnect from Wi-Fi network\n");
+			printf("    ping <ip>                - network probe / connectivity test\n");
+			printf("  Bluetooth (WCN3990 HCI):\n");
+			printf("    bt [status|reset|addr]   - query / control WCN3990 Bluetooth (/dev/hakios-bt)\n");
+			printf("  Device Management:\n");
+			printf("    reboot                   - halt and restart device\n");
