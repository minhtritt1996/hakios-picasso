+		lr = (uintptr_t)context->uc_mcontext->__ss.__lr;
+	}
+	char frames[16 * 20 + 1] = "";
+	size_t used = 0;
+	uintptr_t fp = context != NULL && context->uc_mcontext != NULL ? (uintptr_t)context->uc_mcontext->__ss.__fp : 0;
