+static id
+safe_url_path(id path)
+{
+	if (path == nil) {
+		say("hakios: backboardd: caught nil path in NSURL, substituting fallback container path\n");
+		mkdir("/private/var/containers", 0755);
+		mkdir("/private/var/containers/Data", 0755);
+		mkdir("/private/var/containers/Data/System", 0755);
+		mkdir("/private/var/containers/Data/System/com.apple.backboardd", 0755);
+		return (id)CFSTR("/private/var/containers/Data/System/com.apple.backboardd");
+	}
+	return path;
+}
+
+static id
+my_initFileURLWithPath(id self, SEL selector, id path)
+{
+	return orig_initFileURLWithPath ? orig_initFileURLWithPath(self, selector, safe_url_path(path)) : self;
+}
+
+static id
+my_initFileURLWithPath_isDir(id self, SEL selector, id path, BOOL isDir)
+{
+	return orig_initFileURLWithPath_isDir ? orig_initFileURLWithPath_isDir(self, selector, safe_url_path(path), isDir) : self;
+}
+
+static id
+my_fileURLWithPath(id self, SEL selector, id path)
+{
+	return orig_fileURLWithPath ? orig_fileURLWithPath(self, selector, safe_url_path(path)) : nil;
+}
+
+static id
+my_fileURLWithPath_isDir(id self, SEL selector, id path, BOOL isDir)
+{
+	return orig_fileURLWithPath_isDir ? orig_fileURLWithPath_isDir(self, selector, safe_url_path(path), isDir) : nil;
