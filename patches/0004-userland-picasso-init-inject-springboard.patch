+					close(fd);
+				}
+			} else {
+				printf("%s\n", text);
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "touch ", 6) == 0) {
+			const char *path = cmd + 6;
+			while (*path == ' ') path++;
+			int fd = open(path, O_WRONLY | O_CREAT, 0644);
+			if (fd >= 0) {
+				close(fd);
+			} else {
+				printf("touch: %s: %s\n", path, strerror(errno));
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "mkdir ", 6) == 0) {
+			const char *path = cmd + 6;
+			while (*path == ' ') path++;
+			if (mkdir(path, 0755) != 0) {
+				printf("mkdir: %s: %s\n", path, strerror(errno));
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "rm ", 3) == 0) {
+			const char *path = cmd + 3;
+			while (*path == ' ') path++;
+			if (unlink(path) != 0) {
+				printf("rm: %s: %s\n", path, strerror(errno));
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "rmdir ", 6) == 0) {
+			const char *path = cmd + 6;
+			while (*path == ' ') path++;
+			if (rmdir(path) != 0) {
+				printf("rmdir: %s: %s\n", path, strerror(errno));
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "uname", 5) == 0) {
+			printf("Darwin hakios-picasso 22.5.0 Darwin Kernel Version 22.5.0: SM7250 Picasso arm64\n");
+			continue;
+		}
+
+		if (strcmp(cmd, "whoami") == 0) {
+			printf("root\n");
+			continue;
+		}
+
+		if (strcmp(cmd, "id") == 0) {
+			printf("uid=0(root) gid=0(wheel) groups=0(wheel)\n");
+			continue;
+		}
+
+		if (strcmp(cmd, "hostname") == 0) {
+			printf("hakios-picasso\n");
+			continue;
+		}
+
+		if (strcmp(cmd, "uptime") == 0) {
+			struct timeval tv;
+			gettimeofday(&tv, NULL);
+			printf("up %ld sec, load average: 0.05, 0.02, 0.01\n", tv.tv_sec);
+			continue;
+		}
+
+		if (strcmp(cmd, "date") == 0) {
+			struct timeval tv;
+			gettimeofday(&tv, NULL);
+			printf("timestamp: %ld sec\n", tv.tv_sec);
+			continue;
+		}
+
+		if (strcmp(cmd, "clear") == 0) {
+			printf("\033[2J\033[H");
+			continue;
+		}
+
+		if (strncmp(cmd, "dhcp", 4) == 0 && (cmd[4] == ' ' || cmd[4] == 0)) {
+			char *args = cmd[4] == ' ' ? cmd + 5 : "";
+			while (*args == ' ') args++;
+			cmd_dhcp(*args ? args : "en0");
+			continue;
+		}
+
+		if (strncmp(cmd, "ifconfig", 8) == 0 && (cmd[8] == ' ' || cmd[8] == 0)) {
+			char *args = cmd[8] == ' ' ? cmd + 9 : "";
+			cmd_ifconfig(args);
+			continue;
+		}
+
+		if (strncmp(cmd, "wifi", 4) == 0 && (cmd[4] == ' ' || cmd[4] == 0)) {
+			char *sub = cmd[4] == ' ' ? cmd + 5 : "";
+			while (*sub == ' ') sub++;
+			if (*sub == 0 || strcmp(sub, "status") == 0) {
+				cmd_wifi_status();
+			} else if (strcmp(sub, "scan") == 0) {
+				cmd_wifi_scan();
+			} else if (strncmp(sub, "connect", 7) == 0 && (sub[7] == ' ' || sub[7] == 0)) {
+				char *args = sub[7] == ' ' ? sub + 8 : "";
+				while (*args == ' ') args++;
+				char ssid[33];
