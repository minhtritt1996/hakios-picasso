+static void
+cadisplay_hooks(void)
+{
+	Class cls = objc_getClass("CADisplay");
+	if (cls != NULL) {
+		Method m = class_getClassMethod(cls, sel_registerName("mainDisplay"));
+		if (m != NULL) {
+			orig_cadisplay_mainDisplay = (id (*)(id, SEL))method_setImplementation(m, (IMP)my_cadisplay_mainDisplay);
+			say("hakios: CADisplay mainDisplay hook installed\n");
+		}
+	}
+	Class scls = objc_getClass("CAWindowServer");
+	if (scls != NULL) {
+		Method sm = class_getInstanceMethod(scls, sel_registerName("displayWithDisplayId:"));
+		if (sm != NULL) {
+			orig_caws_displayWithDisplayId = (id (*)(id, SEL, unsigned int))method_setImplementation(sm, (IMP)my_caws_displayWithDisplayId);
+			say("hakios: CAWindowServer displayWithDisplayId hook installed\n");
+		}
+	}
+	Class dcls = objc_getClass("CAWindowServerDisplay");
+	if (dcls != NULL) {
+		Method dm = class_getInstanceMethod(dcls, sel_registerName("setDisablesUpdates:"));
+		if (dm != NULL) {
+			orig_cawsd_setDisablesUpdates = (void (*)(id, SEL, BOOL))method_setImplementation(dm, (IMP)my_cawsd_setDisablesUpdates);
+			say("hakios: CAWindowServerDisplay setDisablesUpdates: hook installed\n");
+		}
+		Method gm = class_getInstanceMethod(dcls, sel_registerName("disablesUpdates"));
+		if (gm != NULL) {
+			orig_cawsd_disablesUpdates = (BOOL (*)(id, SEL))method_setImplementation(gm, (IMP)my_cawsd_disablesUpdates);
+			say("hakios: CAWindowServerDisplay disablesUpdates hook installed\n");
+		}
+		Method bm = class_getInstanceMethod(dcls, sel_registerName("setBlanked:"));
+		if (bm != NULL) {
+			orig_cawsd_setBlanked = (void (*)(id, SEL, BOOL))method_setImplementation(bm, (IMP)my_cawsd_setBlanked);
+			say("hakios: CAWindowServerDisplay setBlanked: hook installed\n");
+		}
+		Method ibm = class_getInstanceMethod(dcls, sel_registerName("isBlanked"));
+		if (ibm != NULL) {
+			orig_cawsd_isBlanked = (BOOL (*)(id, SEL))method_setImplementation(ibm, (IMP)my_cawsd_isBlanked);
+			say("hakios: CAWindowServerDisplay isBlanked hook installed\n");
+		}
+	}
+	Class omClass = objc_getClass("BKDisplayRenderOverlayManager");
+	if (omClass != NULL) {
+		Method m1 = class_getInstanceMethod(omClass, sel_registerName("_updateWindowServerUpdatesForOverlays:"));
+		if (m1 != NULL) {
+			orig_updateWindowServerUpdatesForOverlays = (void (*)(id, SEL, id))method_setImplementation(m1, (IMP)my_updateWindowServerUpdatesForOverlays);
+			say("hakios: BKDisplayRenderOverlayManager _updateWindowServerUpdatesForOverlays: hook installed\n");
+		}
+		Method m2 = class_getInstanceMethod(omClass, sel_registerName("_lock_setOverlaysDisablingUpdates:"));
+		if (m2 != NULL) {
+			orig_lock_setOverlaysDisablingUpdates = (void (*)(id, SEL, id))method_setImplementation(m2, (IMP)my_lock_setOverlaysDisablingUpdates);
+			say("hakios: BKDisplayRenderOverlayManager _lock_setOverlaysDisablingUpdates: hook installed\n");
+		}
+	}
+	dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+		Class wsClass = objc_getClass("CAWindowServer");
+		if (wsClass != NULL) {
+			id server = ((id (*)(Class, SEL))objc_msgSend)(wsClass, sel_registerName("server"));
+			if (server != nil) {
+				id displays = ((id (*)(id, SEL))objc_msgSend)(server, sel_registerName("displays"));
+				unsigned long count = displays ? ((unsigned long (*)(id, SEL))objc_msgSend)(displays, sel_registerName("count")) : 0;
+				for (unsigned long i = 0; i < count; i++) {
+					id d = ((id (*)(id, SEL, unsigned long))objc_msgSend)(displays, sel_registerName("objectAtIndex:"), i);
+					say("hakios: delayed timer unblanking display[%lu]=%p\n", i, d);
+					if (class_getInstanceMethod(object_getClass(d), sel_registerName("setDisablesUpdates:"))) {
+						((void (*)(id, SEL, BOOL))objc_msgSend)(d, sel_registerName("setDisablesUpdates:"), NO);
+					}
+					if (class_getInstanceMethod(object_getClass(d), sel_registerName("setBlanked:"))) {
+						((void (*)(id, SEL, BOOL))objc_msgSend)(d, sel_registerName("setBlanked:"), NO);
+					}
+				}
+			}
+		}
+	});
+}
