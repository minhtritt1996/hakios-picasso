+static id
+my_caws_displayWithDisplayId(id self, SEL sel, unsigned int did)
+{
+	id res = orig_caws_displayWithDisplayId ? orig_caws_displayWithDisplayId(self, sel, did) : nil;
+	say("hakios: -[CAWindowServer displayWithDisplayId:%u] -> %p\n", did, res);
+	if (res == nil) {
+		id displays = ((id (*)(id, SEL))objc_msgSend)(self, sel_registerName("displays"));
+		unsigned long count = displays ? ((unsigned long (*)(id, SEL))objc_msgSend)(displays, sel_registerName("count")) : 0;
+		say("hakios:   -[CAWindowServer displays] count = %lu\n", count);
+		if (count > 0) {
+			res = ((id (*)(id, SEL, unsigned long))objc_msgSend)(displays, sel_registerName("objectAtIndex:"), 0);
+			say("hakios:   -[CAWindowServer displayWithDisplayId:] fallback -> %p\n", res);
+		}
+	}
+	if (res != nil) {
+		SEL s_upd = sel_registerName("setDisablesUpdates:");
+		SEL s_blk = sel_registerName("setBlanked:");
+		if (class_getInstanceMethod(object_getClass(res), s_upd)) {
+			((void (*)(id, SEL, BOOL))objc_msgSend)(res, s_upd, NO);
+			say("hakios:   -[CAWindowServerDisplay setDisablesUpdates:NO] applied on %p\n", res);
+		}
+		if (class_getInstanceMethod(object_getClass(res), s_blk)) {
+			((void (*)(id, SEL, BOOL))objc_msgSend)(res, s_blk, NO);
+			say("hakios:   -[CAWindowServerDisplay setBlanked:NO] applied on %p\n", res);
+		}
+	}
+	return res;
+}
