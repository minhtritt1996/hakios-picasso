diff --git a/tools/raw2bmp.py b/tools/raw2bmp.py
new file mode 100644
index 0000000..a87629e
--- /dev/null
+++ b/tools/raw2bmp.py
@@ -0,0 +1,45 @@
+import struct
+import sys
+
+def raw_to_bmp(raw_path, bmp_path, width=1080, height=2400):
+    with open(raw_path, 'rb') as f:
+        raw = f.read()
+    
+    # 32bpp BGRA
+    row_bytes = width * 4
+    image_size = row_bytes * height
+    file_size = 54 + image_size
+
+    # BMP Header
+    bmp_header = struct.pack(
+        '<2sIHHI',
+        b'BM',
+        file_size,
+        0, 0,
+        54
+    )
+    # DIB Header (BITMAPINFOHEADER)
+    # Note: negative height means top-down bitmap!
+    dib_header = struct.pack(
+        '<IiiHHIIIIII',
+        40,
+        width,
+        -height,
+        1,
+        32,
+        0,
+        image_size,
+        2835, 2835, # 72 DPI
+        0, 0
+    )
+
+    with open(bmp_path, 'wb') as f:
+        f.write(bmp_header)
+        f.write(dib_header)
+        f.write(raw[:image_size])
+    print(f"Saved {bmp_path} ({width}x{height})")
+
+if __name__ == '__main__':
+    raw_path = sys.argv[1] if len(sys.argv) > 1 else '/tmp/screen.raw'
+    bmp_path = sys.argv[2] if len(sys.argv) > 2 else '/tmp/screen.bmp'
+    raw_to_bmp(raw_path, bmp_path)
diff --git a/tools/raw_download.py b/tools/raw_download.py
new file mode 100644
index 0000000..01f6cf2
--- /dev/null
+++ b/tools/raw_download.py
@@ -0,0 +1,55 @@
+import sys
+import time
+import usb.core
+import usb.util
+
+def upload(payload_path):
+    with open(payload_path, 'rb') as f:
+        data = f.read()
+    total = len(data)
+    print(f"Uploading {payload_path}: {total} bytes (0x{total:x})")
+
+    dev = usb.core.find(idVendor=0x18d1, idProduct=0xd00d)
+    if not dev:
+        print("Device not found")
+        sys.exit(1)
+
+    cfg = dev.get_active_configuration()
+    intf = cfg[(0,0)]
+    usb.util.claim_interface(dev, intf)
+    try:
+        ep_out = usb.util.find_descriptor(intf, custom_match=lambda e: usb.util.endpoint_direction(e.bEndpointAddress) == usb.util.ENDPOINT_OUT)
+        ep_in = usb.util.find_descriptor(intf, custom_match=lambda e: usb.util.endpoint_direction(e.bEndpointAddress) == usb.util.ENDPOINT_IN)
+
+        # Send download command
+        cmd = f"download:{total:08x}".encode()
+        ep_out.write(cmd)
+        resp = bytes(ep_in.read(512, timeout=5000)).decode('latin1', errors='replace')
+        print("Download cmd resp:", resp)
+        if not resp.startswith("DATA"):
+            print("Expected DATA, got:", resp)
+            sys.exit(1)
+
+        # Stream data in 64KB chunks
+        chunk_size = 64 * 1024
+        offset = 0
+        t0 = time.time()
+        while offset < total:
+            chunk = data[offset:offset+chunk_size]
+            ep_out.write(chunk, timeout=10000)
+            offset += len(chunk)
+            if offset % (2 * 1024 * 1024) == 0 or offset == total:
+                print(f"Sent {offset}/{total} bytes ({offset*100//total}%)")
+
+        # Read final response (OKAY)
+        resp = bytes(ep_in.read(512, timeout=10000)).decode('latin1', errors='replace')
+        dt = time.time() - t0
+        print(f"Upload complete in {dt:.2f}s, response: {resp}")
+        if not resp.startswith("OKAY"):
+            print("Download failed:", resp)
+            sys.exit(1)
+    finally:
+        usb.util.release_interface(dev, intf)
+
+if __name__ == '__main__':
+    upload(sys.argv[1] if len(sys.argv) > 1 else '/tmp/payload_metal_sm7250.bin')
