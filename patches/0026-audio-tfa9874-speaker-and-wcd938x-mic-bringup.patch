+static void
+update_cwd(const char *path)
+{
+	if (!path || !*path) {
+		return;
+	}
+	if (strcmp(path, ".") == 0) {
+		return;
+	}
+	if (strcmp(path, "..") == 0) {
+		char *last = NULL;
+		for (char *p = shell_cwd; *p; p++) {
+			if (*p == '/') last = p;
+		}
+		if (last && last != shell_cwd) {
+			*last = 0;
+		} else if (last == shell_cwd) {
+			shell_cwd[1] = 0;
+		}
+		return;
+	}
+	if (path[0] == '/') {
+		strcpy(shell_cwd, path);
+	} else {
+		size_t l = strlen(shell_cwd);
+		if (l > 0 && shell_cwd[l - 1] != '/') {
+			shell_cwd[l++] = '/';
+			shell_cwd[l] = 0;
+		}
+		strcpy(shell_cwd + l, path);
+	}
+	size_t len = strlen(shell_cwd);
+	if (len > 1 && shell_cwd[len - 1] == '/') {
+		shell_cwd[len - 1] = 0;
+	}
