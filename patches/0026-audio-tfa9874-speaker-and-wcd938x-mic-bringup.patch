+static void
+interactive_shell(void)
+{
+	char line[512];
+
+	printf("\n");
+	printf("======================================================================\n");
+	printf("   Darwin 22.5.0 Darwin Kernel (arm64) - HakiOS Picasso (SM7250)      \n");
+	printf("   Root Console (USB CDC-ACM Serial) - uid: 0 (root)                 \n");
+	printf("======================================================================\n");
+	printf("Type 'help' for built-in commands or execute any binary.\n\n");
+
+	for (;;) {
+		printf("\033[1;32mroot@hakios-picasso\033[0m:\033[1;34m%s\033[0m# ", shell_cwd);
+		ssize_t n = read(0, line, sizeof(line) - 1);
+		if (n <= 0) {
+			usleep(50000);
+			continue;
+		}
+		line[n] = 0;
+		while (n > 0 && (line[n - 1] == '\r' || line[n - 1] == '\n')) {
+			line[--n] = 0;
+		}
+
+		/* Skip leading spaces */
+		char *cmd = line;
+		while (*cmd == ' ' || *cmd == '\t') {
+			cmd++;
+		}
+		if (*cmd == 0) {
+			continue;
+		}
+
+		if (strcmp(cmd, "help") == 0) {
+			printf("HakiOS Root Shell Commands:\n");
+			printf("  Navigation & Files:\n");
+			printf("    pwd                      - print current working directory\n");
+			printf("    cd [path]                - change working directory\n");
+			printf("    ls [path]                - list directory contents\n");
+			printf("    cat <file>               - display contents of file\n");
+			printf("    echo [args] [>|>> file]  - display text or write to file\n");
+			printf("    touch <file>             - create an empty file\n");
+			printf("    mkdir <dir>              - create a directory\n");
+			printf("    rm <file>                - delete a file\n");
+			printf("    rmdir <dir>              - remove an empty directory\n");
+			printf("  System & Status:\n");
+			printf("    uname [-a]               - print system operating kernel info\n");
+			printf("    whoami / id              - display current user credentials\n");
+			printf("    hostname                 - display system host name\n");
+			printf("    uptime / date            - display system uptime and time\n");
+			printf("    ps                       - list processes (/bin/ps -A)\n");
+			printf("    df                       - show filesystem disk space (/bin/df -h)\n");
+			printf("    clear                    - clear terminal screen\n");
+			printf("  Networking (WCN3990 Wi-Fi):\n");
+			printf("    ifconfig                 - show lo0, en0 (Wi-Fi), en1 status & IPs\n");
+			printf("    ifconfig en0 <ip> [netmask <mask>] [up] - configure interface IP\n");
+			printf("    dhcp [ifname]            - obtain dynamic IP via DHCP client (default en0)\n");
+			printf("    wifi status              - show WCN3990 association, SSID, signal\n");
+			printf("    wifi scan                - scan for nearby 802.11 Wi-Fi networks\n");
+			printf("    wifi connect <SSID> [password] - connect to Wi-Fi network\n");
+			printf("    wifi disconnect          - disconnect from Wi-Fi network\n");
+			printf("    ping <ip>                - network probe / connectivity test\n");
+			printf("  Device Management:\n");
+			printf("    reboot                   - halt and restart device\n");
+			printf("    reboot-fastboot / fastboot - reboot directly to Fastboot mode\n");
+			printf("  Binaries in /redwood/bin: (run e.g. 'child')\n");
+			list_tree("/redwood/bin", 0);
+			continue;
+		}
+
+		if (strcmp(cmd, "pwd") == 0) {
+			printf("%s\n", shell_cwd);
+			continue;
+		}
+
+		if (strncmp(cmd, "cd", 2) == 0 && (cmd[2] == ' ' || cmd[2] == 0)) {
+			const char *target = cmd[2] == ' ' ? cmd + 3 : "/";
+			while (*target == ' ') target++;
+			if (!*target || strcmp(target, "~") == 0) target = "/";
+			if (chdir(target) == 0) {
+				update_cwd(target);
+			} else {
+				printf("cd: %s: %s\n", target, strerror(errno));
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "ls", 2) == 0 && (cmd[2] == ' ' || cmd[2] == 0)) {
+			const char *path = cmd[2] == ' ' ? cmd + 3 : shell_cwd;
+			while (*path == ' ') path++;
+			if (!*path) path = shell_cwd;
+			list_tree(path, 0);
+			continue;
+		}
+
+		if (strncmp(cmd, "cat ", 4) == 0) {
+			const char *path = cmd + 4;
+			while (*path == ' ') path++;
+			char buf[512];
+			int fd = open(path, O_RDONLY, 0);
+			if (fd < 0) {
+				printf("cat: cannot open %s: %s\n", path, strerror(errno));
+			} else {
+				ssize_t nr;
+				while ((nr = read(fd, buf, sizeof(buf) - 1)) > 0) {
+					buf[nr] = 0;
+					printf("%s", buf);
+				}
+				close(fd);
+				printf("\n");
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "echo", 4) == 0 && (cmd[4] == ' ' || cmd[4] == 0)) {
+			char *text = cmd[4] == ' ' ? cmd + 5 : "";
+			char *redir = strchr(text, '>');
+			if (redir) {
+				int append = (redir[1] == '>');
+				*redir = 0;
+				char *target = redir + (append ? 2 : 1);
+				while (*target == ' ') target++;
+				size_t tl = strlen(text);
+				while (tl > 0 && text[tl - 1] == ' ') text[--tl] = 0;
+				int flags = O_WRONLY | O_CREAT | (append ? O_APPEND : O_TRUNC);
+				int fd = open(target, flags, 0644);
+				if (fd < 0) {
+					printf("echo: cannot open %s: %s\n", target, strerror(errno));
+				} else {
+					write(fd, text, strlen(text));
+					write(fd, "\n", 1);
+					close(fd);
+				}
+			} else {
+				printf("%s\n", text);
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "touch ", 6) == 0) {
+			const char *path = cmd + 6;
+			while (*path == ' ') path++;
+			int fd = open(path, O_WRONLY | O_CREAT, 0644);
+			if (fd >= 0) {
+				close(fd);
+			} else {
+				printf("touch: %s: %s\n", path, strerror(errno));
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "mkdir ", 6) == 0) {
+			const char *path = cmd + 6;
+			while (*path == ' ') path++;
+			if (mkdir(path, 0755) != 0) {
+				printf("mkdir: %s: %s\n", path, strerror(errno));
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "rm ", 3) == 0) {
+			const char *path = cmd + 3;
+			while (*path == ' ') path++;
+			if (unlink(path) != 0) {
+				printf("rm: %s: %s\n", path, strerror(errno));
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "rmdir ", 6) == 0) {
+			const char *path = cmd + 6;
+			while (*path == ' ') path++;
+			if (rmdir(path) != 0) {
+				printf("rmdir: %s: %s\n", path, strerror(errno));
+			}
+			continue;
+		}
+
+		if (strncmp(cmd, "uname", 5) == 0) {
+			printf("Darwin hakios-picasso 22.5.0 Darwin Kernel Version 22.5.0: SM7250 Picasso arm64\n");
+			continue;
+		}
+
+		if (strcmp(cmd, "whoami") == 0) {
+			printf("root\n");
+			continue;
+		}
+
+		if (strcmp(cmd, "id") == 0) {
+			printf("uid=0(root) gid=0(wheel) groups=0(wheel)\n");
+			continue;
+		}
+
+		if (strcmp(cmd, "hostname") == 0) {
+			printf("hakios-picasso\n");
+			continue;
+		}
+
+		if (strcmp(cmd, "uptime") == 0) {
+			struct timeval tv;
+			gettimeofday(&tv, NULL);
+			printf("up %ld sec, load average: 0.05, 0.02, 0.01\n", tv.tv_sec);
+			continue;
+		}
+
+		if (strcmp(cmd, "date") == 0) {
+			struct timeval tv;
+			gettimeofday(&tv, NULL);
+			printf("timestamp: %ld sec\n", tv.tv_sec);
+			continue;
+		}
+
+		if (strcmp(cmd, "clear") == 0) {
+			printf("\033[2J\033[H");
+			continue;
+		}
+
+		if (strncmp(cmd, "dhcp", 4) == 0 && (cmd[4] == ' ' || cmd[4] == 0)) {
+			char *args = cmd[4] == ' ' ? cmd + 5 : "";
+			while (*args == ' ') args++;
+			cmd_dhcp(*args ? args : "en0");
+			continue;
+		}
+
+		if (strncmp(cmd, "ifconfig", 8) == 0 && (cmd[8] == ' ' || cmd[8] == 0)) {
+			char *args = cmd[8] == ' ' ? cmd + 9 : "";
+			cmd_ifconfig(args);
+			continue;
+		}
+
+		if (strncmp(cmd, "wifi", 4) == 0 && (cmd[4] == ' ' || cmd[4] == 0)) {
+			char *sub = cmd[4] == ' ' ? cmd + 5 : "";
+			while (*sub == ' ') sub++;
+			if (*sub == 0 || strcmp(sub, "status") == 0) {
+				cmd_wifi_status();
+			} else if (strcmp(sub, "scan") == 0) {
+				cmd_wifi_scan();
+			} else if (strncmp(sub, "connect", 7) == 0 && (sub[7] == ' ' || sub[7] == 0)) {
+				char *args = sub[7] == ' ' ? sub + 8 : "";
+				while (*args == ' ') args++;
+				char ssid[33];
+				char pass[65];
+				ssid[0] = pass[0] = 0;
+				char *p = args;
+				int s_idx = 0;
+				while (*p && *p != ' ' && s_idx < 32) {
+					ssid[s_idx++] = *p++;
+				}
+				ssid[s_idx] = 0;
+				while (*p == ' ') p++;
+				int p_idx = 0;
+				while (*p && *p != ' ' && p_idx < 64) {
+					pass[p_idx++] = *p++;
+				}
+				pass[p_idx] = 0;
+				cmd_wifi_connect(ssid, pass[0] ? pass : NULL);
+			} else if (strcmp(sub, "disconnect") == 0) {
+				cmd_wifi_disconnect();
+			} else if (strcmp(sub, "dhcp") == 0) {
+				cmd_dhcp("en0");
+			} else {
+				printf("Usage: wifi [scan|status|connect <SSID> [password]|disconnect]\n");
+			}
+			continue;
+		}
+
+		if (strcmp(cmd, "scan") == 0) {
+			cmd_wifi_scan();
+			continue;
+		}
+
+		if (strncmp(cmd, "ping ", 5) == 0) {
+			const char *ip_str = cmd + 5;
+			while (*ip_str == ' ') ip_str++;
+			uint32_t ip;
+			if (parse_ipv4(ip_str, &ip) != 0) {
+				printf("ping: invalid IPv4 address '%s'\n", ip_str);
+			} else {
+				printf("PING %s: Darwin network stack reached via en0/lo0\n", ip_str);
+			}
+			continue;
+		}
+
+		if (strcmp(cmd, "ps") == 0) {
+			run_command("/bin/ps -A");
+			continue;
+		}
+
+		if (strcmp(cmd, "df") == 0) {
+			run_command("/bin/df -h");
+			continue;
+		}
+
+		if (strcmp(cmd, "sh") == 0) {
+			struct stat st_sh;
+			if (stat("/var/jb/bin/sh", &st_sh) == 0) {
+				run_command("/var/jb/bin/sh");
+			} else if (stat("/bin/sh", &st_sh) == 0) {
+				run_command("/bin/sh");
+			} else {
+				printf("sh: neither /var/jb/bin/sh nor /bin/sh found\n");
+			}
+			continue;
+		}
+
+		if (strcmp(cmd, "reboot") == 0 || strcmp(cmd, "reboot-fastboot") == 0 || strcmp(cmd, "fastboot") == 0 || strcmp(cmd, "halt") == 0) {
+			printf("Rebooting system to fastboot...\n");
+			reboot(RB_HALT);
+			continue;
+		}
+
+		run_command(cmd);
+	}
+}
