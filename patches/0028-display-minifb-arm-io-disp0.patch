From 0028000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: minhtritt1996 <minhtritt1996@gmail.com>
Date: Wed, 4 Nov 2026 05:46:00 +0700
Subject: [PATCH] display: register disp0 as IOPlatformDevice under /arm-io in gIODTPlane

Attach disp0 under /arm-io with physical DeviceMemory nub in gIODTPlane
for MiniIOMobileFramebuffer, implement 64-byte block shadow diff scanout,
and ensure xnu/files/ is synced into xnu-src on every build.
---
diff --git a/xnu/files/iokit/Kernel/MiniIOMobileFramebuffer.cpp b/xnu/files/iokit/Kernel/MiniIOMobileFramebuffer.cpp
index 93d04b5..4f2866b 100644
--- a/xnu/files/iokit/Kernel/MiniIOMobileFramebuffer.cpp
+++ b/xnu/files/iokit/Kernel/MiniIOMobileFramebuffer.cpp
@@ -34,6 +34,8 @@ extern struct vc_info vinfo;            /* the boot framebuffer, as the text con
 }
 
 #include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceMemory.h>
 
 #include "MiniIOSurface.h"
 
@@ -348,6 +350,11 @@ public:
 	bool            fDiff;
 	uint64_t        fDiffPixels;
 	uint32_t        fDiffLeft, fDiffTop, fDiffRight, fDiffBottom;
+	/* Differential shadow copy for unscaled scanout presentation */
+	uint8_t *       fCopyShadow;
+	uint64_t        fCopyShadowBytes;
+	bool            fCopyShadowValid;
+	uint64_t        fDiffStoredBytes;
 	/* the screen recording, if one was asked for */
 	uint32_t *      fColumn;                /* drawLayer(): source column for every panel column */
 	uint16_t *      fColumnWeight;          /* ... with fb_filter: how much of the column after it, of 256 */
@@ -552,6 +559,14 @@ IOMobileFramebuffer::start(IOService * provider)
 	fColumnWeight = IONewZero(uint16_t, fPanelWidth);
 	fDiff = gDiff != 0;
 	fDiffLeft = fDiffTop = ~0u;
+	fCopyShadowBytes = (uint64_t) fPanelHeight * fRowBytes;
+	fCopyShadow = (uint8_t *) IOMalloc(fCopyShadowBytes);
+	fCopyShadowValid = false;
+	fDiffStoredBytes = 0;
+	if (fCopyShadow != NULL) {
+		bzero(fCopyShadow, fCopyShadowBytes);
+		IOLog("MiniIOMobileFramebuffer: shadow diff copy buffer ready (%llu bytes)\n", fCopyShadowBytes);
+	}
 	IOLog("MiniIOMobileFramebuffer: display %ux%u on a panel of %ux%u (%u bytes per row)\n", fWidth, fHeight,
 	    fPanelWidth, fPanelHeight, fRowBytes);
 
@@ -755,8 +770,59 @@ IOMobileFramebuffer::drawRows(const RowJob * job, int32_t y0, int32_t y1, uint32
 		}
 		to = (uint32_t *) (fBase + (size_t) y * fRowBytes);
 		if (job->unscaled) {
-			/* not scaled at all */
-			memcpy(to + px0, pixels + (size_t) (sy + y - py0) * stride + (size_t) sx * 4, (size_t) sw * 4);
+			/* not scaled at all: use 64-byte block shadow diff to eliminate slow uncached writes */
+			const uint8_t * src_row = pixels + (size_t) (sy + y - py0) * stride + (size_t) sx * 4;
+			uint32_t bytes = (uint32_t) sw * 4;
+			if (fCopyShadow != NULL && (size_t) y * fRowBytes + (size_t) px0 * 4 + bytes <= fCopyShadowBytes) {
+				uint8_t * shadow_row = fCopyShadow + (size_t) y * fRowBytes + (size_t) px0 * 4;
+				if (fCopyShadowValid) {
+					volatile uint64_t * dst64 = (volatile uint64_t *)(to + px0);
+					const uint64_t * src64 = (const uint64_t *)src_row;
+					uint64_t * sh64 = (uint64_t *)shadow_row;
+					uint32_t words = bytes / 8;
+					uint32_t w = 0;
+					for (; w + 8 <= words; w += 8) {
+						uint64_t v[8];
+						__builtin_memcpy(v, (const char *)(src64 + w), 64);
+						if (!((v[0] ^ sh64[w])   | (v[1] ^ sh64[w+1]) | (v[2] ^ sh64[w+2]) | (v[3] ^ sh64[w+3]) |
+						      (v[4] ^ sh64[w+4]) | (v[5] ^ sh64[w+5]) | (v[6] ^ sh64[w+6]) | (v[7] ^ sh64[w+7]))) {
+							continue;
+						}
+						for (unsigned i = 0; i < 8; i++) {
+							dst64[w + i] = v[i];
+							sh64[w + i] = v[i];
+						}
+						fDiffStoredBytes += 64;
+					}
+					for (; w < words; w++) {
+						uint64_t v = src64[w];
+						if (v != sh64[w]) {
+							dst64[w] = v;
+							sh64[w] = v;
+							fDiffStoredBytes += 8;
+						}
+					}
+					uint32_t tail = bytes % 8;
+					if (tail != 0) {
+						volatile uint8_t * d8 = (volatile uint8_t *)(dst64 + w);
+						const uint8_t * s8 = (const uint8_t *)(src64 + w);
+						uint8_t * sh8 = (uint8_t *)(sh64 + w);
+						for (uint32_t i = 0; i < tail; i++) {
+							if (s8[i] != sh8[i]) {
+								d8[i] = s8[i];
+								sh8[i] = s8[i];
+								fDiffStoredBytes++;
+							}
+						}
+					}
+				} else {
+					memcpy(to + px0, src_row, bytes);
+					memcpy(shadow_row, src_row, bytes);
+					fDiffStoredBytes += bytes;
+				}
+			} else {
+				memcpy(to + px0, src_row, bytes);
+			}
 			continue;
 		}
 		if (filter) {
@@ -1235,6 +1301,7 @@ IOMobileFramebuffer::show(const uint8_t * swap, MiniIOSurface ** surfaces)
 				for (uint32_t y = 0; y < fPanelHeight; y++) {
 					bzero(fBase + (size_t) y * fRowBytes, (size_t) fPanelWidth * 4);
 				}
+				fCopyShadowValid = false;
 			}
 			continue;
 		}
@@ -1257,6 +1324,7 @@ IOMobileFramebuffer::show(const uint8_t * swap, MiniIOSurface ** surfaces)
 				/* the first picture: the kernel's text console must stop drawing over it */
 				fGraphics = true;
 				PE_initialize_console(NULL, kPEGraphicsMode);
+				PE_initialize_console(NULL, kPEReleaseScreen);
 			}
 			drawLayer(s, src, dst);
 			if (layer == 0) {
@@ -1265,6 +1333,7 @@ IOMobileFramebuffer::show(const uint8_t * swap, MiniIOSurface ** surfaces)
 		}
 	}
 	drawn = mach_absolute_time();
+	fCopyShadowValid = (fCopyShadow != NULL);
 	if (recorded != NULL) {
 		record(recorded);
 	}
@@ -1296,10 +1365,12 @@ IOMobileFramebuffer::show(const uint8_t * swap, MiniIOSurface ** surfaces)
 		absolutetime_to_nanoseconds(fStatBeatWait, &beat);
 		IOLog("MiniIOMobileFramebuffer: %u frames in %llu ms (%llu a second), %llu us each in the driver, after %llu us "
 		    "waiting for the GPU and, %u of them, %llu us for the next refresh; %u swaps waited for the frame before, "
-		    "%u gave up; %u swaps came a refresh late themselves; %u frames drawn again filtered\n", fStatFrames, nanos / NSEC_PER_MSEC,
+		    "%u gave up; %u swaps came a refresh late themselves; %u frames drawn again filtered; %llu KB/frame written to scanout\n", fStatFrames, nanos / NSEC_PER_MSEC,
 		    fStatFrames * NSEC_PER_SEC / nanos, drawing / fStatFrames / NSEC_PER_USEC,
 		    waiting / fStatFrames / NSEC_PER_USEC, fStatOnBeat, fStatOnBeat ? beat / fStatOnBeat / NSEC_PER_USEC : 0,
-		    fStatHeld, fStatLost, fStatSwapsLate, fStatSettled);
+		    fStatHeld, fStatLost, fStatSwapsLate, fStatSettled,
+		    fStatFrames ? (fDiffStoredBytes / fStatFrames / 1024ULL) : 0ULL);
+		fDiffStoredBytes = 0;
 		fStatSwapsLate = 0;
 		for (different = 0; different < 8 && fStatSurfaces[different] != 0; different++) {
 		}
@@ -1668,13 +1739,45 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 static void
 publishDisplayNode(void)
 {
+	IORegistryEntry * chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	IORegistryEntry * dtRoot = chosen != NULL ? chosen->getParentEntry(gIODTPlane) : NULL;
 	IORegistryEntry * armio = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	IORegistryEntry * existing_disp0 = IORegistryEntry::fromPath("/arm-io/disp0", gIODTPlane);
 	IORegistryEntry * node;
 	OSDictionary * props;
 	OSData * data;
 
+	IOLog("MiniIOMobileFramebuffer: chosen=%p, dtRoot=%p, armio=%p, disp0=%p\n", chosen, dtRoot, armio, existing_disp0);
+
+	if (existing_disp0 != NULL) {
+		existing_disp0->release();
+		if (chosen != NULL) chosen->release();
+		if (armio != NULL) armio->release();
+		return;
+	}
+
+	if (armio == NULL && dtRoot != NULL) {
+		armio = OSTypeAlloc(IORegistryEntry);
+		if (armio != NULL) {
+			props = OSDictionary::withCapacity(2);
+			if (props != NULL) {
+				data = OSData::withBytes("arm-io", sizeof("arm-io"));
+				props->setObject("name", data);
+				OSSafeReleaseNULL(data);
+				if (armio->init(props)) {
+					armio->setName("arm-io");
+					armio->attachToParent(dtRoot, gIODTPlane);
+					IOLog("MiniIOMobileFramebuffer: created /arm-io under device tree root\n");
+				}
+				OSSafeReleaseNULL(props);
+			}
+		}
+	}
+	if (chosen != NULL) {
+		chosen->release();
+	}
 	if (armio == NULL) {
-		IOLog("MiniIOMobileFramebuffer: no /arm-io in the device tree\n");
+		IOLog("MiniIOMobileFramebuffer: no /arm-io in the device tree and failed to create it\n");
 		return;
 	}
 	node = OSTypeAlloc(IORegistryEntry);
@@ -1692,6 +1795,7 @@ publishDisplayNode(void)
 		if (node->init(props)) {
 			node->setName("disp0");
 			node->attachToParent(armio, gIODTPlane);
+			IOLog("MiniIOMobileFramebuffer: disp0 published under /arm-io\n");
 		}
 	}
 	OSSafeReleaseNULL(props);
@@ -1760,16 +1864,66 @@ void
 MiniIOMobileFramebufferStart(IOService * provider)
 {
 	IOMobileFramebuffer * fb = OSTypeAlloc(IOMobileFramebuffer);
-
-	if (fb == NULL || !fb->init() || !fb->attach(provider)) {
-		OSSafeReleaseNULL(fb);
+	if (fb == NULL) {
 		return;
 	}
-	if (fb->start(provider)) {
+
+	IORegistryEntry * treeParent = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	IOService * parent = IOService::getResourceService();
+	IOPlatformDevice * nub = new IOPlatformDevice;
+
+	IODeviceMemory * memory = (vinfo.v_baseaddr != 0 && vinfo.v_depth == 32) ?
+		IODeviceMemory::withRange(vinfo.v_baseaddr, (IOByteCount)vinfo.v_rowbytes * vinfo.v_height) : NULL;
+	OSArray * ranges = OSArray::withCapacity(1);
+	OSData * typeData = OSData::withBytes("display-subsystem", sizeof("display-subsystem"));
+
+	printf("MiniIOMobileFramebuffer: treeParent=%p, parent=%p, memory=%p, v_base=%lx (%ux%u)\n",
+		treeParent, parent, memory, (unsigned long)vinfo.v_baseaddr, (unsigned int)vinfo.v_width, (unsigned int)vinfo.v_height);
+
+	bool nubAttached = false, nubStarted = false, dtAttached = false;
+	bool attached = false, started = false;
+
+	if (nub != NULL && memory != NULL && ranges != NULL && typeData != NULL &&
+	    nub->init() && ranges->setObject(memory)) {
+		nub->setDeviceMemory(ranges);
+		nub->setName("disp0");
+		if (parent != NULL) {
+			nubAttached = nub->attach(parent);
+			if (nubAttached) {
+				nubStarted = nub->start(parent);
+			}
+		}
+		nub->setProperty("device_type", typeData);
+		nub->setName("disp0", gIODTPlane);
+		if (treeParent != NULL) {
+			dtAttached = nub->attachToParent(treeParent, gIODTPlane);
+		}
+		if (fb->init() && fb->attach(nub)) {
+			attached = true;
+			started = fb->start(nub);
+		}
+	} else {
+		if (fb->init() && fb->attach(provider)) {
+			attached = true;
+			started = fb->start(provider);
+		}
+	}
+
+	OSSafeReleaseNULL(typeData);
+	OSSafeReleaseNULL(ranges);
+	OSSafeReleaseNULL(memory);
+	if (treeParent != NULL) {
+		treeParent->release();
+	}
+
+	printf("MiniIOMobileFramebuffer: nubAttached=%d nubStarted=%d dtAttached=%d fb_attached=%d fb_started=%d\n",
+		nubAttached, nubStarted, dtAttached, attached, started);
+
+	if (started) {
 		publishDisplayNode();
 		publishAccelerator(provider);
-	} else {
-		fb->detach(provider);
+	} else if (attached) {
+		fb->detach(nub ? (IOService *)nub : provider);
 	}
 	fb->release();
 }
diff --git a/xnu/sync-drivers.sh b/xnu/sync-drivers.sh
index 0ccb539..0991d06 100755
--- a/xnu/sync-drivers.sh
+++ b/xnu/sync-drivers.sh
@@ -35,3 +35,7 @@ done <<EOF2
 $(python3 "$HERE/../tools/hakios-config.py" external-files)
 EOF2
 [ "$copied" -gt 0 ] || echo "sync-drivers: drivers in step with the kernel tree"
+if [ -d "$HERE/files" ]; then
+	cp -a "$HERE/files/." "$TREE/"
+	echo "sync-drivers: files/ synced into $TREE"
+fi
