diff --git a/xnu-deps/host/bin/xnu-clang b/xnu-deps/host/bin/xnu-clang
index 6ea04a7..de3cd50 100755
--- a/xnu-deps/host/bin/xnu-clang
+++ b/xnu-deps/host/bin/xnu-clang
@@ -4,15 +4,17 @@
 #  - drops flags only Apple's clang understands
 #  - links with the cctools ld64
 HB="$(cd "$(dirname "$0")" && pwd)"
-case "$(basename "$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit);; *) drv=clang; extra=();; esac
+CLANG_BIN=/usr/bin/clang
+[ -x /usr/bin/clang-15 ] && CLANG_BIN=/usr/bin/clang-15
+case "$(basename "$0")" in *++) CLANG_BIN="${CLANG_BIN/clang/clang++}"; extra=(-fno-use-cxa-atexit);; *) extra=();; esac
 args=()
 for a in "$@"; do
   case "$a" in
-    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang) ;;
+    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang|-ftrivial-auto-var-init=zero) ;;
     -fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
     -Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
     *) args+=("$a");;
   esac
 done
-exec /usr/bin/$drv -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
+exec "$CLANG_BIN" -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
   -w "${extra[@]}" "${args[@]}"
