+static uint32_t sweettick_ticks;
+
+static void
+sweettick_intr(__unused void *context, __unused uint32_t intid)
+{
+	armcpu_timer_interrupts++;
+	rtclock_intr(TRUE);
+	/* one dot every two seconds: whether the tick is still alive, visible on the screen */
+	if (++sweettick_ticks % 2000 == 0) {
+		printf(".");
+	}
+}
+
+void
+sweettick_start(void)
+{
+	int on = 0;
+
+	PE_parse_boot_argn("sweettick", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	if (gic_v3_spi_attach(SWEETTICK_INTID, true, sweettick_intr, NULL) != KERN_SUCCESS) {
+		printf("sweettick: cannot attach SPI %u\n", SWEETTICK_INTID);
+		return;
+	}
+	/* The virtual timer's own interrupt can never arrive here: say nothing of it. */
+	__builtin_arm_wsr64("CNTV_CTL_EL0", 0);
+	__builtin_arm_isb(ISB_SY);
+	nanoseconds_to_absolutetime((uint64_t)SWEETTICK_INTERVAL_MS * NSEC_PER_MSEC, &sweettick_interval);
+	sweettick_next = mach_absolute_time() + sweettick_interval;
+	sweettick_on = 1;
+	printf("sweettick: SPI %u pended every %u ms\n", SWEETTICK_INTID, SWEETTICK_INTERVAL_MS);
+}
+
+int
+sweettick_poll(void)
+{
+	uint64_t now;
+
+	if (__improbable(sweettick_on == 0)) {
+		return 1;       /* nothing to wait for */
+	}
+	now = mach_absolute_time();
+	if (now < sweettick_next) {
+		return 0;
+	}
+	sweettick_next = now + sweettick_interval;
+	gic_v3_spi_pend(SWEETTICK_INTID);
+	return 1;
+}
+
+/* Called from machine_idle() with the interrupts masked, in place of a WFI that would never return:
+ * there is no interrupt but this one to wake the core, so spin until the tick has been pended. */
+int
+sweettick_idle(void)
+{
+	if (__improbable(sweettick_on == 0)) {
+		return 0;
+	}
+	while (sweettick_poll() == 0) {
+		__builtin_arm_isb(ISB_SY);
+	}
+	return 1;
+}
