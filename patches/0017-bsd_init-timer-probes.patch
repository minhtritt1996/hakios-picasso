diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 4df41ba..34fcf81 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -147,6 +147,14 @@
 #include <net/if_ether.h>               /* for ether_family_init() */
 #include <net/if_gif.h>                 /* for gif_init() */
 #include <miscfs/devfs/devfsdefs.h>     /* for devfs_kernel_mount() */
+#include <sys/hakios.input.h>
+#include <sys/hakios.audio.h>
+#include <sys/hakios.virtio_blk.h>
+#include <sys/hakios.sparse.h>
+#include <sys/hakios.version.h>
+#if APFS
+#include <sys/hakios.apfs_check.h>
+#endif
 #include <vm/vm_kern.h>                 /* for kmem_suballoc() */
 #include <sys/proc_uuid_policy.h>       /* proc_uuid_policy_init() */
 #include <netinet/flow_divert.h>        /* flow_divert_init() */
@@ -490,7 +498,7 @@ bsd_init(void)
 	platform_stall_panic_or_spin(PLATFORM_STALL_XNU_LOCATION_BSD_INIT);
 #endif
 
-#define DEBUG_BSDINIT 0
+#define DEBUG_BSDINIT 1 /* bring-up: trace bsd_init steps (only visible with -enable_kprintf_spam) */
 
 #if DEBUG_BSDINIT
 #define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
@@ -787,6 +795,7 @@ bsd_init(void)
 
 	bsd_init_kprintf("calling bsd_autoconf\n");
 	bsd_autoconf();
+	printf("HAKIOS: bsd_autoconf done\n");
 
 #if CONFIG_DTRACE
 	dtrace_postinit();
@@ -855,6 +864,29 @@ bsd_init(void)
 
 	bsd_init_kprintf("calling inittodr\n");
 	inittodr(0);
+	printf("HAKIOS: inittodr done\n");	/* Is the counter itself moving? (busy-wait 200 ms, no interrupts needed) */
+	{
+		uint64_t c0 = mach_absolute_time();
+		uint64_t cdelta = 0;
+		printf("HAKIOS: probe: counter busy-wait begins\n");
+		while (1) {
+			absolutetime_to_nanoseconds(mach_absolute_time() - c0, &cdelta);
+			if (cdelta >= 200ULL * 1000 * 1000) {
+				break;
+			}
+		}
+		printf("HAKIOS: probe: counter moved %llu ns in a 200 ms busy-wait\n",
+		    (unsigned long long)cdelta);
+	}
+	printf("HAKIOS: probe: IOSleep(100) begins\n");
+	{
+		uint64_t t0 = mach_absolute_time();
+		uint64_t delta = 0;
+		IOSleep(100);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &delta);
+		printf("HAKIOS: probe: IOSleep(100) returned after %llu ns\n", (unsigned long long)delta);
+	}
+
 
 	/* Mount the root file system. */
 	while (TRUE) {
@@ -862,16 +894,19 @@ bsd_init(void)
 
 		bsd_init_kprintf("calling setconf\n");
 		setconf();
+		printf("HAKIOS: setconf done\n");
 #if CONFIG_NETBOOT
 		netboot = (mountroot == netboot_mountroot);
 #endif
 
 		bsd_init_kprintf("vfs_mountroot\n");
+		printf("HAKIOS: calling vfs_mountroot\n");
 		if (0 == (err = vfs_mountroot())) {
+			printf("HAKIOS: root mounted\n");
 			break;
 		}
 		rootdevice[0] = '\0';
-#if CONFIG_NETBOOT
+	#if CONFIG_NETBOOT
 		if (netboot) {
 			PE_display_icon( 0, "noroot");  /* XXX a netboot-specific icon would be nicer */
 			vc_progress_set(FALSE, 0);
@@ -892,6 +927,7 @@ bsd_init(void)
 	mountlist.tqh_first->mnt_flag |= MNT_ROOTFS;
 
 	bsd_init_kprintf("calling VFS_ROOT\n");
+	printf("HAKIOS: VFS_ROOT\n");
 	/* Get the vnode for '/'.  Set fdp->fd_fd.fd_cdir to reference it. */
 	if (VFS_ROOT(mountlist.tqh_first, &init_rootvnode, vfs_context_kernel())) {
 		panic("bsd_init: cannot find root vnode: %s", PE_boot_args());
@@ -976,6 +1012,15 @@ bsd_init(void)
 
 		bsd_init_kprintf("calling devfs_kernel_mount\n");
 		devfs_kernel_mount(mounthere);
+		hakios_version_init();         /* kern.hakios.version, and the version in the boot log */
+		hakios_input_init();           /* /dev/hakios-touch */
+		hakios_audio_init();           /* /dev/hakios-audio */
+		hakios_virtio_blk_init();      /* /dev/rvblk0, a disk image of the host (QEMU) */
+		hakios_sparse_init();          /* /dev/rsp0, part of an image too big to hold */
+#if APFS
+		/* mounts and walks /dev/rvblk0 once userland has /private/var up */
+		hakios_apfs_check_init();
+#endif
 	}
 #endif /* DEVFS */
 
@@ -1021,6 +1066,7 @@ bsd_init(void)
 	siginit(kernproc);
 
 	bsd_init_kprintf("calling bsd_utaskbootstrap\n");
+	printf("HAKIOS: utaskbootstrap\n");
 	bsd_utaskbootstrap();
 
 	pal_kernel_announce();
@@ -1108,7 +1154,9 @@ setconf(void)
 	u_int32_t       flags;
 	kern_return_t   err;
 
+	printf("HAKIOS: setconf: rootdevice=[%s] calling IOFindBSDRoot\n", rootdevice);
 	err = IOFindBSDRoot(rootdevice, sizeof(rootdevice), &rootdev, &flags);
+	printf("HAKIOS: setconf: IOFindBSDRoot err=%d rootdev=%#x\n", err, (unsigned)rootdev);
 	if (err) {
 		printf("setconf: IOFindBSDRoot returned an error (%d);"
 		    "setting rootdevice to 'sd0a'.\n", err);     /* XXX DEBUG TEMP */
