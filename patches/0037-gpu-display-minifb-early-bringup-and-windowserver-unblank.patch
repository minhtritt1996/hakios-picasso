+static void
+cmd_bt(const char *sub)
+{
+	int fd = open("/dev/hakios-bt", O_RDWR, 0);
+	if (fd < 0) {
+		printf("bt: cannot open /dev/hakios-bt: %s\n", strerror(errno));
+		return;
+	}
+
+	if (!sub || !*sub || strcmp(sub, "status") == 0) {
+		printf("Bluetooth device: /dev/hakios-bt\n");
+		printf("  Controller: Qualcomm WCN3990 (QUPV3 SE5 UART @ 0x894000)\n");
+		printf("  State: Active (devfs character device)\n");
+	} else if (strcmp(sub, "reset") == 0) {
+		printf("Sending HCI_Reset (0x01, 0x03, 0x0c, 0x00)...\n");
+		const uint8_t reset_cmd[] = { 0x01, 0x03, 0x0c, 0x00 };
+		write(fd, reset_cmd, sizeof(reset_cmd));
+		usleep(150000);
+		uint8_t resp[64];
+		ssize_t n = read(fd, resp, sizeof(resp));
+		if (n > 0) {
+			printf("HCI_Reset Response (%zd bytes):", n);
+			for (ssize_t i = 0; i < n; i++) printf(" %02x", resp[i]);
+			printf("\n");
+			if (n >= 6 && resp[0] == 0x04 && resp[1] == 0x0e && resp[6] == 0x00) {
+				printf("[OK] HCI_Reset SUCCESS!\n");
+			}
+		} else {
+			printf("bt: no response received\n");
+		}
+	} else if (strcmp(sub, "addr") == 0) {
+		printf("Sending HCI_Read_BD_ADDR (0x01, 0x09, 0x10, 0x00)...\n");
+		const uint8_t bdaddr_cmd[] = { 0x01, 0x09, 0x10, 0x00 };
+		write(fd, bdaddr_cmd, sizeof(bdaddr_cmd));
+		usleep(150000);
+		uint8_t resp[64];
+		ssize_t n = read(fd, resp, sizeof(resp));
+		if (n > 0) {
+			printf("HCI_Read_BD_ADDR Response (%zd bytes):", n);
+			for (ssize_t i = 0; i < n; i++) printf(" %02x", resp[i]);
+			printf("\n");
+			if (n >= 12 && resp[0] == 0x04 && resp[1] == 0x0e && resp[6] == 0x00) {
+				printf("[OK] BD_ADDR: %02X:%02X:%02X:%02X:%02X:%02X\n",
+				       resp[12], resp[11], resp[10], resp[9], resp[8], resp[7]);
+			}
+		} else {
+			printf("bt: no response received\n");
+		}
+	} else {
+		printf("Usage: bt [status|reset|addr]\n");
+	}
+
+	close(fd);
+}
+
 static void
 interactive_shell(void)
 {
@@ -2393,6 +2448,8 @@ interactive_shell(void)
 			printf("    wifi connect <SSID> [password] - connect to Wi-Fi network\n");
 			printf("    wifi disconnect          - disconnect from Wi-Fi network\n");
 			printf("    ping <ip>                - network probe / connectivity test\n");
+			printf("  Bluetooth (WCN3990 HCI):\n");
+			printf("    bt [status|reset|addr]   - query / control WCN3990 Bluetooth (/dev/hakios-bt)\n");
 			printf("  Device Management:\n");
 			printf("    reboot                   - halt and restart device\n");
 			printf("    reboot-fastboot / fastboot - reboot directly to Fastboot mode\n");
@@ -2602,6 +2659,13 @@ interactive_shell(void)
 			continue;
 		}
 
+		if (strncmp(cmd, "bt", 2) == 0 && (cmd[2] == ' ' || cmd[2] == 0)) {
+			char *sub = cmd[2] == ' ' ? cmd + 3 : "";
+			while (*sub == ' ') sub++;
+			cmd_bt(sub);
+			continue;
+		}
+
 		if (strncmp(cmd, "ping ", 5) == 0) {
 			const char *ip_str = cmd + 5;
 			while (*ip_str == ' ') ip_str++;
