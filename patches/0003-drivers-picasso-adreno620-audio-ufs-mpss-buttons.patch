+static int
+fb_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return (vinfo.v_baseaddr != 0) ? 0 : ENODEV;
+}
+
+static int
+fb_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+fb_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (vinfo.v_baseaddr == 0) {
+		return EIO;
+	}
+	uint64_t total = (uint64_t)vinfo.v_rowbytes * vinfo.v_height;
+	uint64_t off = (uint64_t)uio_offset(uio);
+	if (off >= total) {
+		return 0;
+	}
+	size_t count = (size_t)uio_resid(uio);
+	if (off + count > total) {
+		count = (size_t)(total - off);
+	}
+	return uiomove((caddr_t)(vinfo.v_baseaddr + off), (int)count, uio);
