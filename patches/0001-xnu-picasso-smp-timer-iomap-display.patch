+		    gic_read32(gicd_base + GICD_CTLR), gic_read32(gicd_base + GICD_ISENABLER(0)),
+		    gic_read32(gicd_base + GICD_IGROUPR(0)), gic_read32(gicd_base + GICD_IGRPMODR(0)),
+		    gic_read32(gicd_base + GICD_ICACTIVER(0)));
+	} else {
+		printf("HAKIOS gic: no distributor base\n");
+	}
+	if (gicr != 0) {
+		printf("HAKIOS gic: GICR isenabler0 %#x icpendr0 %#x igroupr0 %#x igrpmodr0 %#x "
+		    "icactiver0 %#x waker %#x\n",
+		    gic_read32(gicr + GICR_ISENABLER0), gic_read32(gicr + GICR_ICPENDR0),
+		    gic_read32(gicr + GICR_IGROUPR0), gic_read32(gicr + GICR_IGRPMODR0),
+		    gic_read32(gicr + GICR_ICACTIVER0), gic_read32(gicr + GICR_WAKER));
+	} else {
+		printf("HAKIOS gic: no redistributor for cpu 0\n");
+	}
+	/* Can the non-secure side change any of this at all? Write and read back. */
+	if (gicr != 0) {
+		uint32_t g0 = gic_read32(gicr + GICR_IGROUPR0);
+
+		gic_write32(gicr + GICR_IGROUPR0, 0xffffffffu);
+		printf("HAKIOS gic: IGROUPR0 was %#x, wrote ffffffff, reads %#x\n", g0,
+		    gic_read32(gicr + GICR_IGROUPR0));
+	}
+	if (gicd_base != 0) {
+		uint32_t typer = gic_read32(gicd_base + 0x0004);
+
+		printf("HAKIOS gic: GICD_TYPER %#x SecurityExtn %d (%s) ITLines %u\n", typer,
+		    (int)((typer >> 10) & 1),
+		    ((typer >> 10) & 1) ? "dual state: the secure side owns the PPIs"
+		    : "single state: the write was swallowed by something else (hypervisor)",
+		    (unsigned)(((typer & 0x1f) + 1) * 32));
+	}
+	if (gicd_base != 0) {
+		uint32_t c0 = gic_read32(gicd_base + GICD_CTLR);
+
+		gic_write32(gicd_base + GICD_CTLR, c0 | 1u);
+		printf("HAKIOS gic: GICD_CTLR was %#x, tried EnableGrp0, reads %#x\n", c0,
+		    gic_read32(gicd_base + GICD_CTLR));
