+IOReturn
+IOMobileFramebuffer::newUserClient(task_t owningTask, void * securityID,
+    UInt32 type, OSDictionary * properties,
+    IOUserClient ** handler)
+{
+	IOLog("MiniIOMobileFramebuffer: newUserClient(type=%u, task=%p)\n", (unsigned) type, owningTask);
+	IOMobileFramebufferUserClient * client = OSTypeAlloc(IOMobileFramebufferUserClient);
+	if (!client) {
+		IOLog("MiniIOMobileFramebuffer: newUserClient OSTypeAlloc failed\n");
+		return kIOReturnNoMemory;
+	}
+	if (!client->initWithTask(owningTask, securityID, type, properties)) {
+		IOLog("MiniIOMobileFramebuffer: newUserClient initWithTask failed\n");
+		client->release();
+		return kIOReturnBadArgument;
+	}
+	if (!client->attach(this)) {
+		IOLog("MiniIOMobileFramebuffer: newUserClient attach failed\n");
+		client->release();
+		return kIOReturnUnsupported;
+	}
+	if (!client->start(this)) {
+		IOLog("MiniIOMobileFramebuffer: newUserClient start failed\n");
+		client->detach(this);
+		client->release();
+		return kIOReturnUnsupported;
+	}
+	*handler = client;
+	IOLog("MiniIOMobileFramebuffer: newUserClient SUCCEEDED -> client=%p\n", client);
+	return kIOReturnSuccess;
+}
