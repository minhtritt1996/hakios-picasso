+void
+IOMobileFramebuffer::addClient(IOMobileFramebufferUserClient * client)
+{
+	IOLockLock(fLock);
+	if (fClients != NULL) {
+		fClients->setObject(client);
+		printf("MiniIOMobileFramebuffer: added client %p (total %u)\n", client, fClients->getCount());
+	}
+	IOLockUnlock(fLock);
+}
+
+void
+IOMobileFramebuffer::removeClient(IOMobileFramebufferUserClient * client)
+{
+	IOLockLock(fLock);
+	if (fClients != NULL) {
+		for (unsigned int i = 0; i < fClients->getCount(); i++) {
+			if (fClients->getObject(i) == client) {
+				fClients->removeObject(i);
+				printf("MiniIOMobileFramebuffer: removed client %p (remaining %u)\n", client, fClients->getCount());
+				break;
+			}
+		}
+	}
+	IOLockUnlock(fLock);
+}
+
+void
+IOMobileFramebuffer::vsyncFired(OSObject * owner, IOTimerEventSource * sender)
+{
+	IOMobileFramebuffer * fb = (IOMobileFramebuffer *)owner;
+	uint64_t now = mach_absolute_time();
+	uint64_t count = ++fb->fVsyncCount;
+	uint64_t values[6] = {
+		(uint32_t)count, (uint32_t)(count >> 32),
+		(uint32_t)now,   (uint32_t)(now >> 32),
+		0, 0,
+	};
+
+	IOLockLock(fb->fLock);
+	if (fb->fClients != NULL) {
+		unsigned int n = fb->fClients->getCount();
+		for (unsigned int i = 0; i < n; i++) {
+			IOMobileFramebufferUserClient * client =
+			    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
+			if (client != NULL) {
+				client->notify(kFBNotifyVSync, values, 6);
+			}
+		}
+	}
+	IOLockUnlock(fb->fLock);
+
+	uint32_t interval_us = 1000000 / refreshHz();
+	sender->setTimeoutUS(interval_us);
+}
