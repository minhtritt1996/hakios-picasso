++/*
++ * The tick this port cannot get from the architecture: PPI 27 is a group-0 interrupt, owned by the
++ * secure side (GICD_TYPER.SecurityExtn is 1 and the redistributor's IGROUPR0 cannot be written from
++ * here), so the virtual timer is enabled, unmasked, asserting -- and never delivered.
++ *
++ * So the clock is driven from software: whoever runs (the idle loop, a boot-time probe) polls the
++ * counter and pends a group-1 SPI, which is delivered. That takes the place of the timer interrupt:
++ * rtclock_intr() runs and the sleepers of assert_wait_deadline() wake.
++ *
++ * boot-arg sweettick=1.
++ */
++#define SWEETTICK_INTID         700u   /* inside ITLines (<=991) and not used by a driver here */
++#define SWEETTICK_INTERVAL_MS   1u
++
++static uint64_t sweettick_next;
++static uint64_t sweettick_interval;
++static uint32_t sweettick_on;
++
++void sweettick_start(void);
++int sweettick_poll(void);
++int sweettick_idle(void);
++extern kern_return_t gic_v3_spi_attach(uint32_t intid, bool edge, void (*handler)(void *context, uint32_t intid), void *context);
++extern void gic_v3_spi_pend(uint32_t intid);
++
++/* The USB console driver (picasso_usb.c) reports this as the timer count. */
++volatile uint64_t armcpu_timer_interrupts;
++
++static void
++sweettick_intr(__unused void *context, __unused uint32_t intid)
++{
++	armcpu_timer_interrupts++;
++	rtclock_intr(TRUE);
++}
++
++void
++sweettick_start(void)
++{
++	int on = 0;
++
++	PE_parse_boot_argn("sweettick", &on, sizeof(on));
++	if (!on) {
++		return;
++	}
++	if (gic_v3_spi_attach(SWEETTICK_INTID, true, sweettick_intr, NULL) != KERN_SUCCESS) {
++		printf("sweettick: cannot attach SPI %u\n", SWEETTICK_INTID);
++		return;
++	}
++	/* The virtual timer's own interrupt can never arrive here: say nothing of it. */
++	__builtin_arm_wsr64("CNTV_CTL_EL0", 0);
++	__builtin_arm_isb(ISB_SY);
++	nanoseconds_to_absolutetime((uint64_t)SWEETTICK_INTERVAL_MS * NSEC_PER_MSEC, &sweettick_interval);
++	sweettick_next = mach_absolute_time() + sweettick_interval;
++	sweettick_on = 1;
++	printf("sweettick: SPI %u pended every %u ms\n", SWEETTICK_INTID, SWEETTICK_INTERVAL_MS);
++}
++
++int
++sweettick_poll(void)
++{
++	uint64_t now;
++
++	if (__improbable(sweettick_on == 0)) {
++		return 1;       /* nothing to wait for */
++	}
++	now = mach_absolute_time();
++	if (now < sweettick_next) {
++		return 0;
++	}
++	sweettick_next = now + sweettick_interval;
++	gic_v3_spi_pend(SWEETTICK_INTID);
++	return 1;
++}
++
++/* A thread is about to block with a deadline: pend a tick right away, or nothing will ever wake it
++ * (no timer interrupt reaches this port). */
++void
++sweettick_note_wait(void)
++{
++	if (__improbable(sweettick_on == 0)) {
++		return;
++	}
++	sweettick_next = mach_absolute_time();
++	gic_v3_spi_pend(SWEETTICK_INTID);
++}
++
++int
++sweettick_idle(void)
++{
++	if (__improbable(sweettick_on == 0)) {
++		return 0;
++	}
++	while (sweettick_poll() == 0) {
++		__builtin_arm_isb(ISB_SY);
++	}
++	return 1;
++}
