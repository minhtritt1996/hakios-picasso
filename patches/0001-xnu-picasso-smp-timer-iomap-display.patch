+		__builtin_arm_wsr64("CNTV_CTL_EL0", 1);
+		__builtin_arm_isb(ISB_SY);
+		for (unsigned i = 0; i < sizeof(ids) / sizeof(ids[0]); i++) {
+			uint32_t id = ids[i];
+			uint32_t before = gic_read32(gicr + 0x0200);
+
+			gic_write32(gicr + GICR_ISENABLER0, 1u << (id % 32));
+			printf("HAKIOS gic: intid %u enabled, pend %#x -> %#x hppir1 %#llx\n", id, before,
+			    gic_read32(gicr + 0x0200),
+			    (unsigned long long)__builtin_arm_rsr64("ICC_HPPIR1_EL1"));
+			gic_write32(gicr + GICR_ICENABLER0, 1u << (id % 32));
+		}
+	}
