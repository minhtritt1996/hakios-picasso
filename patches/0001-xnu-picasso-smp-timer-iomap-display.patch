 }
 
+static void
+psci_smp_clean_to_memory(vm_offset_t start, size_t length)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r" (ctr));
+	uintptr_t line = (uintptr_t)4 << ((ctr >> 16) & 15);
+	uintptr_t address = (uintptr_t)start & ~(line - 1);
+	uintptr_t end = (uintptr_t)start + length;
+	for (; address < end; address += line) {
+		__asm__ volatile ("dc civac, %0" :: "r" (address) : "memory");
+	}
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+
 static void
 psci_smp_clean_segment(const char *name)
 {
@@ -147,7 +162,7 @@ psci_smp_clean_segment(const char *name)
