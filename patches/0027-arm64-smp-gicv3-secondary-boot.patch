diff --git a/xnu/files/osfmk/arm64/gic_v3_irq.c b/xnu/files/osfmk/arm64/gic_v3_irq.c
index 63ffd4b..57de773 100644
--- a/xnu/files/osfmk/arm64/gic_v3_irq.c
+++ b/xnu/files/osfmk/arm64/gic_v3_irq.c
@@ -48,12 +48,15 @@
 #define GICD_IGROUPR(n)         (0x0080 + 4 * (n))
 #define GICD_ISENABLER(n)       (0x0100 + 4 * (n))
 #define GICD_ICENABLER(n)       (0x0180 + 4 * (n))
+#define GICD_ISPENDR(n)         (0x0200 + 4 * (n))
 #define GICD_ICPENDR(n)         (0x0280 + 4 * (n))
 #define GICD_ICACTIVER(n)       (0x0380 + 4 * (n))
 #define GICD_IPRIORITYR(n)      (0x0400 + (n))
 #define GICD_ICFGR(n)           (0x0c00 + 4 * (n))
 #define GICD_IGRPMODR(n)        (0x0d00 + 4 * (n))
-#define GICD_IROUTER(n)         (0x6000 + 8 * (n))
+#define GICD_IROUTER(n)         (0x6000 + 8 * ((n) - 32))
+
+#define GIC_SPI_IPI_BASE        1008
 
 #define GICR_FRAME_SIZE         0x20000     /* RD_base + SGI_base per CPU */
 #define GICR_TYPER              0x0008
@@ -72,7 +75,11 @@
 
 #define GIC_SGI_SIGNAL          0           /* cpu_signal(): another processor wants this one's attention */
 #define GIC_SGI_STOP            1           /* psci_smp_stop_here(): the system is going back to the boot loader */
-#define GIC_INTID_VTIMER        27          /* EL1 virtual timer PPI */
+#define GIC_INTID_VTIMER_DEFAULT 27         /* ARM's EL1 virtual timer PPI */
+/* Boot-arg virtual_timer_intid=N (UniXNU: picasso's own Linux DT puts the virtual timer at INTID 19,
+ * i.e. PPI 3, so the number this world must watch is a board fact, not the architectural default). */
+uint32_t gic_vtimer_intid = GIC_INTID_VTIMER_DEFAULT;
+#define GIC_INTID_VTIMER        gic_vtimer_intid
 #define GIC_INTID_SPI_MIN       32
 #define GIC_INTID_SPURIOUS_MIN  1020
 #define GIC_SPI_MOST            48          /* attached at a time */
@@ -157,17 +164,74 @@ gic_send_sgi(uint32_t phys_id, uint32_t sgi)
 	__builtin_arm_isb(ISB_SY);
 }
 
+
+static inline uint64_t
+gic_route_affinity(uint64_t aff)
+{
+	return ((aff & 0xffULL) << 32) | (((aff >> 8) & 0xffULL) << 40) |
+	       (((aff >> 16) & 0xffULL) << 48) | (((aff >> 32) & 0xffULL) << 56);
+}
+
+static void
+gic_spi_ipi_configure(uint32_t cpu, uint64_t mpidr)
+{
+	uint32_t id = GIC_SPI_IPI_BASE + cpu;
+
+	if (gicd_base == 0) {
+		return;
+	}
+	/* Group 1 */
+	gic_write32(gicd_base + GICD_IGROUPR(id / 32),
+	    gic_read32(gicd_base + GICD_IGROUPR(id / 32)) | (1u << (id % 32)));
+	gic_write32(gicd_base + GICD_IGRPMODR(id / 32),
+	    gic_read32(gicd_base + GICD_IGRPMODR(id / 32)) & ~(1u << (id % 32)));
+	/* Edge-triggered: 2 in 2-bit field */
+	gic_write32(gicd_base + GICD_ICFGR(id / 16),
+	    (gic_read32(gicd_base + GICD_ICFGR(id / 16)) & ~(3u << ((id % 16) * 2))) |
+	    (2u << ((id % 16) * 2)));
+	/* Priority */
+	*(volatile uint8_t *)(gicd_base + GICD_IPRIORITYR(id)) = 0x80;
+	/* Route to target CPU affinity */
+	*(volatile uint64_t *)(gicd_base + GICD_IROUTER(id)) = gic_route_affinity(mpidr);
+	__builtin_arm_dsb(DSB_SY);
+	/* Enable */
+	gic_write32(gicd_base + GICD_ISENABLER(id / 32), 1u << (id % 32));
+	__builtin_arm_dsb(DSB_SY);
+}
+
+static void
+gic_spi_ipi_send(uint32_t target_cpu)
+{
+	uint32_t id = GIC_SPI_IPI_BASE + target_cpu;
+
+	if (gicd_base == 0) {
+		return;
+	}
+	__builtin_arm_dsb(DSB_ISHST);
+	gic_write32(gicd_base + GICD_ISPENDR(id / 32), 1u << (id % 32));
+	__builtin_arm_dsb(DSB_SY);
+}
 /* The platform's half of cpu_signal(): interrupt that processor (GenericARMCPU::signalCPU()). */
 void
 gic_v3_irq_signal(uint32_t phys_id)
 {
-	gic_send_sgi(phys_id, GIC_SGI_SIGNAL);
+	int target_cpu = ml_get_cpu_number(phys_id);
+	if (target_cpu >= 0 && target_cpu < MAX_CPUS) {
+		gic_spi_ipi_send((uint32_t)target_cpu);
+	} else {
+		gic_send_sgi(phys_id, GIC_SGI_SIGNAL);
+	}
 }
 
 void
 gic_v3_irq_signal_stop(uint32_t phys_id)
 {
-	gic_send_sgi(phys_id, GIC_SGI_STOP);
+	int target_cpu = ml_get_cpu_number(phys_id);
+	if (target_cpu >= 0 && target_cpu < MAX_CPUS) {
+		gic_spi_ipi_send((uint32_t)target_cpu);
+	} else {
+		gic_send_sgi(phys_id, GIC_SGI_STOP);
+	}
 }
 
 /* An SPI that a driver has attached: its handler called. false: nobody has it. */
@@ -251,6 +315,10 @@ gic_v3_spi_attach(uint32_t intid, bool edge, void (*handler)(void *context, uint
 	os_atomic_store(&slot->intid, intid, release);
 	simple_unlock(&gic_spi_lock);
 
+	printf("hakios gic: SPI %u: igroupr %#x igrpmodr %#x isenabler %#x priority %#x icfgr %#x\n", intid,
+	    gic_read32(gicd_base + GICD_IGROUPR(intid / 32)), gic_read32(gicd_base + GICD_IGRPMODR(intid / 32)),
+	    gic_read32(gicd_base + GICD_ISENABLER(intid / 32)), gic_read32(gicd_base + GICD_IPRIORITYR(intid) & ~3),
+	    gic_read32(gicd_base + GICD_ICFGR(intid / 16)));
 	gic_v3_spi_mask(intid);
 	gic_write32(gicd_base + GICD_ICPENDR(intid / 32), 1u << (intid % 32));
 	gic_write32(gicd_base + GICD_ICACTIVER(intid / 32), 1u << (intid % 32));
@@ -259,13 +327,31 @@ gic_v3_spi_attach(uint32_t intid, bool edge, void (*handler)(void *context, uint
 	*(volatile uint8_t *)(gicd_base + GICD_IPRIORITYR(intid)) = GIC_PRIORITY_DEFAULT;
 	config = gic_read32(gicd_base + GICD_ICFGR(intid / 16)) & ~(3u << (intid % 16 * 2));
 	gic_write32(gicd_base + GICD_ICFGR(intid / 16), config | (edge ? 2u : 0u) << (intid % 16 * 2));
-	/* GICD_IROUTER: Aff3 in [39:32], Aff2.Aff1.Aff0 in [23:0]; bit 31 (any processor) clear */
-	*(volatile uint64_t *)(gicd_base + GICD_IROUTER(intid)) = (mpidr & 0xff00000000ull) | (mpidr & 0xffffff);
+	/* GICD_IROUTER: Aff0 in [39:32], Aff1 in [47:40], Aff2 in [55:48], Aff3 in [63:56] */
+	*(volatile uint64_t *)(gicd_base + GICD_IROUTER(intid)) = gic_route_affinity(mpidr);
 	gic_distributor_settle();
 	gic_v3_spi_unmask(intid);
 	return KERN_SUCCESS;
 }
 
+/*
+ * Pend an SPI from software (GICD_ISPENDR). A group-1 SPI is delivered to this world, which the
+ * PPIs of the architectural timer are not: GICD_TYPER.SecurityExtn is 1 here, so PPI 27 belongs to
+ * the secure side and never reaches EL1. A soft SPI is how a tick can be delivered all the same.
+ */
+void
+gic_v3_spi_pend(uint32_t intid)
+{
+	if (gicd_base == 0 || intid < GIC_INTID_SPI_MIN || intid >= GIC_INTID_SPURIOUS_MIN) {
+		return;
+	}
+	__asm__ volatile ("dsb ishst" ::: "memory");
+	gic_write32(gicd_base + GICD_ICPENDR(intid / 32), 0);
+	gic_write32(gicd_base + GICD_ICPENDR(intid / 32), 0);
+	gic_write32(gicd_base + 0x0200 + 4 * (intid / 32), 1u << (intid % 32));
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
 /* ... and gives it back: disabled, nothing pending, and no handler of it running when this returns. */
 void
 gic_v3_spi_detach(uint32_t intid)
@@ -319,6 +405,9 @@ gic_irq_handler(__unused void *target, __unused void *refCon, __unused void *nub
 		} else if (intid == GIC_SGI_STOP) {
 			/* comes back only if nobody has in fact asked for that */
 			psci_smp_stop_here();
+		} else if (intid >= GIC_SPI_IPI_BASE && intid < GIC_SPI_IPI_BASE + MAX_CPUS) {
+			psci_smp_stop_here();
+			cpu_signal_handler();
 		} else if (intid >= GIC_INTID_SPI_MIN && gic_spi_handle(intid)) {
 			/* a driver's */
 		} else {
@@ -346,6 +435,12 @@ gic_v3_irq_quiesce(void)
 	int cpu;
 
 	if (gicd_base == 0) {
+		uint32_t vtimer = GIC_INTID_VTIMER_DEFAULT;
+
+		PE_parse_boot_argn("virtual_timer_intid", &vtimer, sizeof(vtimer));
+		if (vtimer >= 16 && vtimer <= 47) {
+			gic_vtimer_intid = vtimer;
+		}
 		return;         /* as early as this there is no interrupt, nor a cpu number to ask for */
 	}
 	cpu = cpu_number();
@@ -405,9 +500,6 @@ gic_find_redistributor(void)
 		if ((uint32_t)(typer >> 32) == affinity) {
 			return frame;
 		}
-		if (typer & GICR_TYPER_LAST) {
-			break;
-		}
 	}
 	panic("gic: no redistributor for MPIDR 0x%llx", mpidr);
 }
@@ -458,6 +550,30 @@ gic_v3_irq_cpu_init(void)
 		}
 	}
 
+	/* Configure SPI IPI for this core */
+	gic_spi_ipi_configure((uint32_t)cpu, __builtin_arm_rsr64("MPIDR_EL1"));
+	if (ml_get_topology_info() != NULL) {
+		for (int c = 0; c <= ml_get_max_cpu_number(); c++) {
+			uint32_t phys = ml_get_topology_info()->cpus[c].phys_id;
+			if (phys != 0) {
+				gic_spi_ipi_configure((uint32_t)c, phys);
+			}
+		}
+	}
+
+	/*
+	 * The SGIs and PPIs come out of the firmware as group 0, and this kernel only enables group 1
+	 * at the distributor (GICD_CTLR 0x12): every one of them, the timer's included, was therefore
+	 * dropped in silence -- HPPIR1 read 1023 with the virtual timer enabled, unmasked and
+	 * asserting. Say which group 1, and the timer starts arriving.
+	 */
+	if ((gic_read32(gicr + GICR_IGROUPR0) & (1u << GIC_INTID_VTIMER)) == 0) {
+		printf("hakios gic: cpu %d: PPIs group 0 (%#x); moving them to group 1\n", cpu,
+		    gic_read32(gicr + GICR_IGROUPR0));
+		gic_write32(gicr + GICR_IGROUPR0, 0xffffffffu);
+		printf("hakios gic: PPIs now group %#x\n", gic_read32(gicr + GICR_IGROUPR0));
+	}
+
 	/*
 	 * The interrupts between processors, where there is more than one. A core that an earlier
 	 * kernel switched off in the middle of one (a return to the boot loader, started again
@@ -506,3 +622,87 @@ gic_v3_irq_cpu_init(void)
 }
 
 #endif /* GENERIC_GIC_V3_IRQ */
+
+/*
+ * The state a timer interrupt would have to be taken through, for the boot-arg gicprobe: the CPU
+ * interface's registers and the enable/pending/group bits of the virtual timer's PPI (27) in the
+ * redistributor and the distributor. Printed (the kernel log is what reaches logdump); the
+ * loader's own ring (loader_cp_hex) hangs here.
+ */
+void
+gic_v3_probe_dump(void)
+{
+	vm_offset_t gicr = gicr_cpu_base[0];
+	uint64_t hppir1, rpr, ctlr;
+
+	/* Group-1 registers only: ICC_HPPIR0_EL1 and ICC_IGRPEN0_EL1 belong to group 0 and reading them
+	 * from EL1 traps where the secure monitor keeps that group (this port dies in silence). */
+	__builtin_arm_isb(ISB_SY);
+	hppir1 = __builtin_arm_rsr64("ICC_HPPIR1_EL1");
+	rpr = __builtin_arm_rsr64("ICC_RPR_EL1");
+	ctlr = __builtin_arm_rsr64("ICC_CTLR_EL1");
+	printf("HAKIOS gic: hppir1 %#llx rpr %#llx ctlr %#llx\n",
+	    (unsigned long long)hppir1, (unsigned long long)rpr, (unsigned long long)ctlr);
+	if (gicd_base != 0) {
+		printf("HAKIOS gic: GICD ctlr %#x isenabler0 %#x igroupr0 %#x igrpmodr0 %#x icactiver0 %#x\n",
+		    gic_read32(gicd_base + GICD_CTLR), gic_read32(gicd_base + GICD_ISENABLER(0)),
+		    gic_read32(gicd_base + GICD_IGROUPR(0)), gic_read32(gicd_base + GICD_IGRPMODR(0)),
+		    gic_read32(gicd_base + GICD_ICACTIVER(0)));
+	} else {
+		printf("HAKIOS gic: no distributor base\n");
+	}
+	if (gicr != 0) {
+		printf("HAKIOS gic: GICR isenabler0 %#x icpendr0 %#x igroupr0 %#x igrpmodr0 %#x "
+		    "icactiver0 %#x waker %#x\n",
+		    gic_read32(gicr + GICR_ISENABLER0), gic_read32(gicr + GICR_ICPENDR0),
+		    gic_read32(gicr + GICR_IGROUPR0), gic_read32(gicr + GICR_IGRPMODR0),
+		    gic_read32(gicr + GICR_ICACTIVER0), gic_read32(gicr + GICR_WAKER));
+	} else {
+		printf("HAKIOS gic: no redistributor for cpu 0\n");
+	}
+	/* Can the non-secure side change any of this at all? Write and read back. */
+	if (gicr != 0) {
+		uint32_t g0 = gic_read32(gicr + GICR_IGROUPR0);
+
+		gic_write32(gicr + GICR_IGROUPR0, 0xffffffffu);
+		printf("HAKIOS gic: IGROUPR0 was %#x, wrote ffffffff, reads %#x\n", g0,
+		    gic_read32(gicr + GICR_IGROUPR0));
+	}
+	if (gicd_base != 0) {
+		uint32_t typer = gic_read32(gicd_base + 0x0004);
+
+		printf("HAKIOS gic: GICD_TYPER %#x SecurityExtn %d (%s) ITLines %u\n", typer,
+		    (int)((typer >> 10) & 1),
+		    ((typer >> 10) & 1) ? "dual state: the secure side owns the PPIs"
+		    : "single state: the write was swallowed by something else (hypervisor)",
+		    (unsigned)(((typer & 0x1f) + 1) * 32));
+	}
+	if (gicd_base != 0) {
+		uint32_t c0 = gic_read32(gicd_base + GICD_CTLR);
+
+		gic_write32(gicd_base + GICD_CTLR, c0 | 1u);
+		printf("HAKIOS gic: GICD_CTLR was %#x, tried EnableGrp0, reads %#x\n", c0,
+		    gic_read32(gicd_base + GICD_CTLR));
+	}
+	/* Which INTID does the phone deliver the timer as? Enable one at a time and look, so that a
+	 * delivered interrupt cannot be mistaken for another one. */
+	if (gicr != 0) {
+		static const uint32_t ids[] = { 19, 27, 28, 30 };
+
+		__builtin_arm_wsr64("CNTV_TVAL_EL0", 200000);
+		__builtin_arm_wsr64("CNTV_CTL_EL0", 1);
+		__builtin_arm_isb(ISB_SY);
+		for (unsigned i = 0; i < sizeof(ids) / sizeof(ids[0]); i++) {
+			uint32_t id = ids[i];
+			uint32_t before = gic_read32(gicr + 0x0200);
+
+			gic_write32(gicr + GICR_ISENABLER0, 1u << (id % 32));
+			printf("HAKIOS gic: intid %u enabled, pend %#x -> %#x hppir1 %#llx\n", id, before,
+			    gic_read32(gicr + 0x0200),
+			    (unsigned long long)__builtin_arm_rsr64("ICC_HPPIR1_EL1"));
+			gic_write32(gicr + GICR_ICENABLER0, 1u << (id % 32));
+		}
+	}
+	__builtin_arm_isb(ISB_SY);
+	printf("HAKIOS gic: after the writes hppir1 %#llx\n", (unsigned long long)__builtin_arm_rsr64("ICC_HPPIR1_EL1"));
+}
diff --git a/xnu/files/osfmk/arm64/psci_smp.c b/xnu/files/osfmk/arm64/psci_smp.c
index 221defa..c5cbdb0 100644
--- a/xnu/files/osfmk/arm64/psci_smp.c
+++ b/xnu/files/osfmk/arm64/psci_smp.c
@@ -140,6 +140,21 @@ psci_smp_cpu_running(void)
 	psci_smp_cpu_reached(PSCI_SMP_CPU_RUNNING);
 }
 
+static void
+psci_smp_clean_to_memory(vm_offset_t start, size_t length)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r" (ctr));
+	uintptr_t line = (uintptr_t)4 << ((ctr >> 16) & 15);
+	uintptr_t address = (uintptr_t)start & ~(line - 1);
+	uintptr_t end = (uintptr_t)start + length;
+	for (; address < end; address += line) {
+		__asm__ volatile ("dc civac, %0" :: "r" (address) : "memory");
+	}
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+
 static void
 psci_smp_clean_segment(const char *name)
 {
@@ -147,7 +162,7 @@ psci_smp_clean_segment(const char *name)
 	vm_offset_t start = (vm_offset_t)getsegdatafromheader(&_mh_execute_header, name, &size);
 
 	if (start != 0 && size != 0) {
-		CleanPoC_DcacheRegion(start, size);
+		psci_smp_clean_to_memory(start, size);
 	}
 }
 
@@ -159,6 +174,7 @@ psci_smp_clean_segment(const char *name)
 kern_return_t
 psci_smp_start_cpu(int cpu)
 {
+	extern boot_args const_boot_args;
 	cpu_data_t *cdp = cpu_datap(cpu);
 	uint32_t phys_id = cdp->cpu_phys_id, stage;
 	uint64_t entry = ml_static_vtop((vm_offset_t)&LowResetVectorBase);
@@ -170,19 +186,23 @@ psci_smp_start_cpu(int cpu)
 	 * the reset vector finds its way by (ResetHandlerData, CpuDataEntries, the boot arguments,
 	 * cpu_ttep, psci_smp_hvc ...), all of it in the kernel's own segments; and the cpu data of
 	 * every processor, which the reset vector goes through looking for its own.
-	 * Clean, not flush: the processors that are running keep using all of it.
+	 * Clean and invalidate to PoC so lines are visible to cores with MMU/caches disabled.
 	 */
